@startuml
title productdiscovery - application
hide empty members
skinparam classAttributeIconSize 0

package "commandservices" {
    interface FavoriteProductCommandService {
        +handle(command : SaveProductAsFavoriteCommand) : Result<FavoriteProduct,ApplicationError>
        +handle(command : RemoveProductFromFavoritesCommand) : Result<FavoriteProduct,ApplicationError>
    }
    interface ProductCommandService {
        +handle(command : SeedProductsCommand) : void
    }
    interface ProductCompatibilityCommandService {
        +handle(command : GenerateProductCompatibilityCommand) : void
    }
}

package "internal.commandservices" {
    class FavoriteProductCommandServiceImpl {
        -favoriteProductRepository : FavoriteProductRepository
        +FavoriteProductCommandServiceImpl(favoriteProductRepository : FavoriteProductRepository)
        +handle(command : SaveProductAsFavoriteCommand) : Result<FavoriteProduct,ApplicationError>
        +handle(command : RemoveProductFromFavoritesCommand) : Result<FavoriteProduct,ApplicationError>
    }
    class ProductCommandServiceImpl {
        -productRepository : ProductRepository
        -productCatalogService : ProductCatalogService
        +ProductCommandServiceImpl(productRepository : ProductRepository, productCatalogService : ProductCatalogService)
        +handle(command : SeedProductsCommand) : void
        -seedFromOpenBeautyFacts() : void
        -buildInitialCatalog() : List<Product>
        -buildProduct(name : String, brand : String, category : ProductCategory, description : String, benefits : List<String>, aiRecommended : boolean) : Product
        -fallbackImageFor(category : ProductCategory) : String
    }
    class ProductCompatibilityCommandServiceImpl {
        -productCompatibilityRepository : ProductCompatibilityRepository
        +ProductCompatibilityCommandServiceImpl(productCompatibilityRepository : ProductCompatibilityRepository)
        +handle(command : GenerateProductCompatibilityCommand) : void
        -calculateScore(category : String, skinType : String) : int
        -buildReason(skinType : String) : String
    }
}

package "internal.eventhandlers" {
    class ApplicationReadyEventHandler {
        -SKIN_TYPES : List<String>
        -productCommandService : ProductCommandService
        -productCompatibilityCommandService : ProductCompatibilityCommandService
        -productRepository : ProductRepository
        -productCompatibilityRepository : ProductCompatibilityRepository
        +ApplicationReadyEventHandler(productCommandService : ProductCommandService, productCompatibilityCommandService : ProductCompatibilityCommandService, productRepository : ProductRepository, productCompatibilityRepository : ProductCompatibilityRepository)
        +on(event : ApplicationReadyEvent) : void
        -seedCompatibilitiesIfNeeded(applicationName : String) : void
        -currentTimestamp() : Timestamp
    }
}

package "internal.outboundservices.catalog" {
    interface ProductCatalogService {
        +fetchProductsByCategory(searchTerm : String, category : String, limit : int) : List<Product>
    }
}

package "internal.outboundservices.images" {
    interface ProductImageService {
        +fetchImageUrl(productName : String, category : String) : String
    }
}

package "internal.queryservices" {
    class FavoriteProductQueryServiceImpl {
        -favoriteProductRepository : FavoriteProductRepository
        +FavoriteProductQueryServiceImpl(favoriteProductRepository : FavoriteProductRepository)
        +handle(query : GetFavoriteProductsByUserIdQuery) : List<FavoriteProduct>
    }
    class ProductCompatibilityQueryServiceImpl {
        -productCompatibilityRepository : ProductCompatibilityRepository
        +ProductCompatibilityQueryServiceImpl(productCompatibilityRepository : ProductCompatibilityRepository)
        +handle(query : GetCompatibilitiesByProductIdQuery) : List<ProductCompatibility>
        +handle(query : GetCompatibilitiesBySkinTypeQuery) : List<ProductCompatibility>
    }
    class ProductQueryServiceImpl {
        -productRepository : ProductRepository
        +ProductQueryServiceImpl(productRepository : ProductRepository)
        +handle(query : GetAllProductsQuery) : List<Product>
        +handle(query : GetProductByIdQuery) : Optional<Product>
    }
}

package "queryservices" {
    interface FavoriteProductQueryService {
        +handle(query : GetFavoriteProductsByUserIdQuery) : List<FavoriteProduct>
    }
    interface ProductCompatibilityQueryService {
        +handle(query : GetCompatibilitiesByProductIdQuery) : List<ProductCompatibility>
        +handle(query : GetCompatibilitiesBySkinTypeQuery) : List<ProductCompatibility>
    }
    interface ProductQueryService {
        +handle(query : GetAllProductsQuery) : List<Product>
        +handle(query : GetProductByIdQuery) : Optional<Product>
    }
}

FavoriteProductCommandServiceImpl ..|> FavoriteProductCommandService
ProductCommandServiceImpl ..|> ProductCommandService
ProductCommandServiceImpl --> ProductCatalogService : productCatalogService
ProductCompatibilityCommandServiceImpl ..|> ProductCompatibilityCommandService
ApplicationReadyEventHandler --> ProductCommandService : productCommandService
ApplicationReadyEventHandler --> ProductCompatibilityCommandService : productCompatibilityCommandService
FavoriteProductQueryServiceImpl ..|> FavoriteProductQueryService
ProductCompatibilityQueryServiceImpl ..|> ProductCompatibilityQueryService
ProductQueryServiceImpl ..|> ProductQueryService
@enduml