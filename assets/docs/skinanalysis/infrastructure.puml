@startuml
title skinanalysis - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "persistence.jpa.adapters" {
    class FacialScanRepositoryImpl {
        -persistenceRepository : FacialScanPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +FacialScanRepositoryImpl(persistenceRepository : FacialScanPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<FacialScan>
        +findAllByPatientId(patientId : PatientId) : List<FacialScan>
        +save(facialScan : FacialScan) : FacialScan
    }
    class SkinAnalysisRepositoryImpl {
        -persistenceRepository : SkinAnalysisPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +SkinAnalysisRepositoryImpl(persistenceRepository : SkinAnalysisPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<SkinAnalysis>
        +findByFacialScanId(facialScanId : FacialScanId) : Optional<SkinAnalysis>
        +findAllByPatientId(patientId : PatientId) : List<SkinAnalysis>
        +save(skinAnalysis : SkinAnalysis) : SkinAnalysis
    }
    class SkinProfileRepositoryImpl {
        -persistenceRepository : SkinProfilePersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +SkinProfileRepositoryImpl(persistenceRepository : SkinProfilePersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<SkinProfile>
        +findByPatientId(patientId : PatientId) : Optional<SkinProfile>
        +existsByPatientId(patientId : PatientId) : boolean
        +save(skinProfile : SkinProfile) : SkinProfile
    }
}

package "persistence.jpa.assemblers" {
    class FacialScanPersistenceAssembler {
        -FacialScanPersistenceAssembler()
        +toDomainFromPersistence(entity : FacialScanPersistenceEntity) : FacialScan
        +toPersistenceFromDomain(facialScan : FacialScan) : FacialScanPersistenceEntity
    }
    class SkinAnalysisPersistenceAssembler {
        -SkinAnalysisPersistenceAssembler()
        +toDomainFromPersistence(entity : SkinAnalysisPersistenceEntity) : SkinAnalysis
        +toPersistenceFromDomain(skinAnalysis : SkinAnalysis) : SkinAnalysisPersistenceEntity
    }
    class SkinProfilePersistenceAssembler {
        -SkinProfilePersistenceAssembler()
        +toDomainFromPersistence(entity : SkinProfilePersistenceEntity) : SkinProfile
        +toPersistenceFromDomain(skinProfile : SkinProfile) : SkinProfilePersistenceEntity
    }
}

package "persistence.jpa.converters" {
    class FacialScanIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : FacialScanId) : Long
        +convertToEntityAttribute(dbData : Long) : FacialScanId
    }
    class PatientIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PatientId) : Long
        +convertToEntityAttribute(dbData : Long) : PatientId
    }
}

package "persistence.jpa.entities" {
    class FacialScanPersistenceEntity {
        -patientId : PatientId
        -status : FacialScanStatus
        -photoUrl : String
        -scannedAt : LocalDateTime
        +FacialScanPersistenceEntity()
        +getPatientId() : PatientId
        +setPatientId(patientId : PatientId) : void
        +getStatus() : FacialScanStatus
        +setStatus(status : FacialScanStatus) : void
        +getPhotoUrl() : String
        +setPhotoUrl(photoUrl : String) : void
        +getScannedAt() : LocalDateTime
        +setScannedAt(scannedAt : LocalDateTime) : void
    }
    class SkinAnalysisPersistenceEntity {
        -patientId : PatientId
        -facialScanId : FacialScanId
        -skinType : String
        -overallScore : Double
        -hydrationScore : Double
        -textureScore : Double
        -sensitivityScore : Double
        -brightnessScore : Double
        -status : SkinAnalysisStatus
        -analyzedAt : LocalDateTime
        +SkinAnalysisPersistenceEntity()
        +getPatientId() : PatientId
        +setPatientId(patientId : PatientId) : void
        +getFacialScanId() : FacialScanId
        +setFacialScanId(facialScanId : FacialScanId) : void
        +getSkinType() : String
        +setSkinType(skinType : String) : void
        +getOverallScore() : Double
        +setOverallScore(overallScore : Double) : void
        +getHydrationScore() : Double
        +setHydrationScore(hydrationScore : Double) : void
        +getTextureScore() : Double
        +setTextureScore(textureScore : Double) : void
        +getSensitivityScore() : Double
        +setSensitivityScore(sensitivityScore : Double) : void
        +getBrightnessScore() : Double
        +setBrightnessScore(brightnessScore : Double) : void
        +getStatus() : SkinAnalysisStatus
        +setStatus(status : SkinAnalysisStatus) : void
        +getAnalyzedAt() : LocalDateTime
        +setAnalyzedAt(analyzedAt : LocalDateTime) : void
    }
    class SkinProfilePersistenceEntity {
        -patientId : PatientId
        -skinType : SkinType
        -sensitivity : Sensitivity
        -waterIntake : String
        -sunExposure : String
        -sleepHours : String
        -status : SkinProfileStatus
        +SkinProfilePersistenceEntity()
        +getPatientId() : PatientId
        +setPatientId(patientId : PatientId) : void
        +getSkinType() : SkinType
        +setSkinType(skinType : SkinType) : void
        +getSensitivity() : Sensitivity
        +setSensitivity(sensitivity : Sensitivity) : void
        +getWaterIntake() : String
        +setWaterIntake(waterIntake : String) : void
        +getSunExposure() : String
        +setSunExposure(sunExposure : String) : void
        +getSleepHours() : String
        +setSleepHours(sleepHours : String) : void
        +getStatus() : SkinProfileStatus
        +setStatus(status : SkinProfileStatus) : void
    }
}

package "persistence.jpa.repositories" {
    interface FacialScanPersistenceRepository {
        +findAllByPatientId(patientId : PatientId) : List<FacialScanPersistenceEntity>
    }
    interface SkinAnalysisPersistenceRepository {
        +findByFacialScanId(facialScanId : FacialScanId) : Optional<SkinAnalysisPersistenceEntity>
        +findAllByPatientId(patientId : PatientId) : List<SkinAnalysisPersistenceEntity>
    }
    interface SkinProfilePersistenceRepository {
        +findByPatientId(patientId : PatientId) : Optional<SkinProfilePersistenceEntity>
        +existsByPatientId(patientId : PatientId) : boolean
    }
}

FacialScanRepositoryImpl --> FacialScanPersistenceRepository : persistenceRepository
SkinAnalysisRepositoryImpl --> SkinAnalysisPersistenceRepository : persistenceRepository
SkinProfileRepositoryImpl --> SkinProfilePersistenceRepository : persistenceRepository
FacialScanPersistenceAssembler ..> FacialScanPersistenceEntity
SkinAnalysisPersistenceAssembler ..> SkinAnalysisPersistenceEntity
SkinProfilePersistenceAssembler ..> SkinProfilePersistenceEntity
FacialScanPersistenceRepository ..> FacialScanPersistenceEntity
SkinAnalysisPersistenceRepository ..> SkinAnalysisPersistenceEntity
SkinProfilePersistenceRepository ..> SkinProfilePersistenceEntity
@enduml