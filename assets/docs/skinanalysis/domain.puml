@startuml
title skinanalysis - domain
hide empty members
skinparam classAttributeIconSize 0

package "model.aggregates" {
    class FacialScan {
        -id : Long
        -patientId : PatientId
        -status : FacialScanStatus
        -photoUrl : String
        -scannedAt : LocalDateTime
        +FacialScan(command : StartFacialScanCommand)
        +FacialScan(id : Long, patientId : PatientId, status : FacialScanStatus, photoUrl : String, scannedAt : LocalDateTime)
        +submit(photoUrl : String) : void
        +onStarted() : void
        +onSubmitted() : void
        +getPatientId() : Long
        +getPatientIdValue() : PatientId
    }
    class SkinAnalysis {
        -id : Long
        -patientId : PatientId
        -facialScanId : FacialScanId
        -skinType : String
        -overallScore : Double
        -hydrationScore : Double
        -textureScore : Double
        -sensitivityScore : Double
        -brightnessScore : Double
        -status : SkinAnalysisStatus
        -analyzedAt : LocalDateTime
        +SkinAnalysis(command : AnalyzeSkinScanCommand)
        +SkinAnalysis(id : Long, patientId : PatientId, facialScanId : FacialScanId, skinType : String, overallScore : Double, hydrationScore : Double, textureScore : Double, sensitivityScore : Double, brightnessScore : Double, status : SkinAnalysisStatus, analyzedAt : LocalDateTime)
        +onAnalysisCompleted() : void
        +getPatientId() : Long
        +getFacialScanId() : Long
        +getPatientIdValue() : PatientId
        +getFacialScanIdValue() : FacialScanId
    }
    class SkinProfile {
        -id : Long
        -patientId : PatientId
        -skinType : SkinType
        -sensitivity : Sensitivity
        -waterIntake : String
        -sunExposure : String
        -sleepHours : String
        -status : SkinProfileStatus
        +SkinProfile(command : CompleteSkinProfileCommand)
        +SkinProfile(id : Long, patientId : PatientId, skinType : SkinType, sensitivity : Sensitivity, waterIntake : String, sunExposure : String, sleepHours : String, status : SkinProfileStatus)
        +update(command : UpdateSkinCharacteristicsCommand) : void
        +onCompleted() : void
        +onUpdated() : void
    }
}

package "model.commands" {
    class AnalyzeSkinScanCommand << record >> {
        +facialScanId : Long
        +patientId : Long
        +skinType : String
        +sensitivity : String
    }
    class CompleteSkinProfileCommand << record >> {
        +patientId : Long
        +skinType : String
        +sensitivity : String
        +waterIntake : String
        +sunExposure : String
        +sleepHours : String
    }
    class StartFacialScanCommand << record >> {
        +patientId : Long
    }
    class SubmitFacialScanCommand << record >> {
        +facialScanId : Long
        +photoUrl : String
    }
    class UpdateSkinCharacteristicsCommand << record >> {
        +skinProfileId : Long
        +skinType : String
        +sensitivity : String
        +waterIntake : String
        +sunExposure : String
        +sleepHours : String
    }
}

package "model.events" {
    class FacialScanStartedEvent << record >> {
        +facialScanId : Long
        +patientId : Long
        +from(facialScan : FacialScan) : FacialScanStartedEvent
    }
    class FacialScanSubmittedEvent << record >> {
        +facialScanId : Long
        +patientId : Long
        +from(facialScan : FacialScan) : FacialScanSubmittedEvent
    }
    class PreliminaryDiagnosisGeneratedEvent << record >> {
        +skinAnalysisId : Long
        +patientId : Long
        +overallScore : Double
        +skinType : String
        +from(skinAnalysis : SkinAnalysis) : PreliminaryDiagnosisGeneratedEvent
    }
    class SkinCharacteristicsUpdatedEvent << record >> {
        +skinProfileId : Long
        +patientId : Long
        +skinType : String
        +from(skinProfile : SkinProfile) : SkinCharacteristicsUpdatedEvent
    }
    class SkinProfileCompletedEvent << record >> {
        +skinProfileId : Long
        +patientId : Long
        +skinType : String
        +from(skinProfile : SkinProfile) : SkinProfileCompletedEvent
    }
}

package "model.queries" {
    class GetFacialScanByIdQuery << record >> {
        +facialScanId : Long
    }
    class GetFacialScansByPatientIdQuery << record >> {
        +patientId : PatientId
    }
    class GetSkinAnalysesByPatientIdQuery << record >> {
        +patientId : PatientId
    }
    class GetSkinAnalysisByFacialScanIdQuery << record >> {
        +facialScanId : FacialScanId
    }
    class GetSkinAnalysisByIdQuery << record >> {
        +skinAnalysisId : Long
    }
    class GetSkinProfileByIdQuery << record >> {
        +skinProfileId : Long
    }
    class GetSkinProfileByPatientIdQuery << record >> {
        +patientId : PatientId
    }
}

package "model.valueobjects" {
    class FacialScanId << record >> {
        +facialScanId : Long
    }
    enum FacialScanStatus {
        STARTED
        SUBMITTED
        COMPLETED
        FAILED
    }
    class PatientId << record >> {
        +patientId : Long
    }
    enum Sensitivity {
        LOW
        MEDIUM
        HIGH
    }
    enum SkinAnalysisStatus {
        PENDING
        COMPLETED
    }
    enum SkinProfileStatus {
        PENDING
        COMPLETED
    }
    enum SkinType {
        NORMAL
        DRY
        OILY
        COMBINATION
        SENSITIVE
    }
}

package "repositories" {
    interface FacialScanRepository {
        +findById(id : Long) : Optional<FacialScan>
        +findAllByPatientId(patientId : PatientId) : List<FacialScan>
        +save(facialScan : FacialScan) : FacialScan
    }
    interface SkinAnalysisRepository {
        +findById(id : Long) : Optional<SkinAnalysis>
        +findByFacialScanId(facialScanId : FacialScanId) : Optional<SkinAnalysis>
        +findAllByPatientId(patientId : PatientId) : List<SkinAnalysis>
        +save(skinAnalysis : SkinAnalysis) : SkinAnalysis
    }
    interface SkinProfileRepository {
        +findById(id : Long) : Optional<SkinProfile>
        +findByPatientId(patientId : PatientId) : Optional<SkinProfile>
        +existsByPatientId(patientId : PatientId) : boolean
        +save(skinProfile : SkinProfile) : SkinProfile
    }
}

FacialScan --> PatientId : patientId
FacialScan --> FacialScanStatus : status
FacialScan ..> StartFacialScanCommand
SkinAnalysis --> PatientId : patientId
SkinAnalysis --> FacialScanId : facialScanId
SkinAnalysis --> SkinAnalysisStatus : status
SkinAnalysis ..> AnalyzeSkinScanCommand
SkinProfile --> PatientId : patientId
SkinProfile --> SkinType : skinType
SkinProfile --> Sensitivity : sensitivity
SkinProfile --> SkinProfileStatus : status
SkinProfile ..> CompleteSkinProfileCommand
SkinProfile ..> UpdateSkinCharacteristicsCommand
FacialScanStartedEvent ..> FacialScan
FacialScanSubmittedEvent ..> FacialScan
PreliminaryDiagnosisGeneratedEvent ..> SkinAnalysis
SkinCharacteristicsUpdatedEvent ..> SkinProfile
SkinProfileCompletedEvent ..> SkinProfile
GetFacialScansByPatientIdQuery --> PatientId : patientId
GetSkinAnalysesByPatientIdQuery --> PatientId : patientId
GetSkinAnalysisByFacialScanIdQuery --> FacialScanId : facialScanId
GetSkinProfileByPatientIdQuery --> PatientId : patientId
FacialScanRepository ..> FacialScan
FacialScanRepository ..> PatientId
SkinAnalysisRepository ..> SkinAnalysis
SkinAnalysisRepository ..> FacialScanId
SkinAnalysisRepository ..> PatientId
SkinProfileRepository ..> SkinProfile
SkinProfileRepository ..> PatientId
@enduml