@startuml
title skinanalysis - application
hide empty members
skinparam classAttributeIconSize 0

package "commandservices" {
    interface FacialScanCommandService {
        +handle(command : StartFacialScanCommand) : Result<Long,ApplicationError>
        +handle(command : SubmitFacialScanCommand) : Result<Long,ApplicationError>
    }
    interface SkinAnalysisCommandService {
        +handle(command : AnalyzeSkinScanCommand) : Result<Long,ApplicationError>
    }
    interface SkinProfileCommandService {
        +handle(command : CompleteSkinProfileCommand) : Result<Long,ApplicationError>
        +handle(command : UpdateSkinCharacteristicsCommand) : Result<Long,ApplicationError>
    }
}

package "internal.commandservices" {
    class FacialScanCommandServiceImpl {
        -PATIENT_NOT_FOUND : String
        -PATIENT_ID_INVALID : String
        -SCAN_NOT_FOUND : String
        -SCAN_ALREADY_SUBMITTED : String
        -PHOTO_URL_BLANK : String
        -facialScanRepository : FacialScanRepository
        -externalIamService : ExternalIamService
        +FacialScanCommandServiceImpl(facialScanRepository : FacialScanRepository, externalIamService : ExternalIamService)
        +handle(command : StartFacialScanCommand) : Result<Long,ApplicationError>
        +handle(command : SubmitFacialScanCommand) : Result<Long,ApplicationError>
    }
    class SkinAnalysisCommandServiceImpl {
        -ANALYSIS_ALREADY_EXISTS : String
        -FACIAL_SCAN_ID_INVALID : String
        -skinAnalysisRepository : SkinAnalysisRepository
        +SkinAnalysisCommandServiceImpl(skinAnalysisRepository : SkinAnalysisRepository)
        +handle(command : AnalyzeSkinScanCommand) : Result<Long,ApplicationError>
    }
    class SkinProfileCommandServiceImpl {
        -PATIENT_NOT_FOUND : String
        -PROFILE_ALREADY_EXISTS : String
        -PROFILE_NOT_FOUND : String
        -skinProfileRepository : SkinProfileRepository
        -externalIamService : ExternalIamService
        +SkinProfileCommandServiceImpl(skinProfileRepository : SkinProfileRepository, externalIamService : ExternalIamService)
        +handle(command : CompleteSkinProfileCommand) : Result<Long,ApplicationError>
        +handle(command : UpdateSkinCharacteristicsCommand) : Result<Long,ApplicationError>
    }
}

package "internal.eventhandlers" {
    class FacialScanSubmittedEventHandler {
        -skinProfileQueryService : SkinProfileQueryService
        -skinAnalysisCommandService : SkinAnalysisCommandService
        +FacialScanSubmittedEventHandler(skinProfileQueryService : SkinProfileQueryService, skinAnalysisCommandService : SkinAnalysisCommandService)
        +on(event : FacialScanSubmittedEvent) : void
    }
    class PreliminaryDiagnosisGeneratedEventHandler {
        -eventPublisher : ApplicationEventPublisher
        +PreliminaryDiagnosisGeneratedEventHandler(eventPublisher : ApplicationEventPublisher)
        +on(event : PreliminaryDiagnosisGeneratedEvent) : void
    }
}

package "internal.outboundservices.acl" {
    class ExternalIamService {
        -iamContextFacade : IamContextFacade
        +ExternalIamService(iamContextFacade : IamContextFacade)
        +fetchPatientById(patientId : Long) : Optional<PatientId>
    }
}

package "internal.queryservices" {
    class FacialScanQueryServiceImpl {
        -facialScanRepository : FacialScanRepository
        +FacialScanQueryServiceImpl(facialScanRepository : FacialScanRepository)
        +handle(query : GetFacialScanByIdQuery) : Optional<FacialScan>
        +handle(query : GetFacialScansByPatientIdQuery) : List<FacialScan>
    }
    class SkinAnalysisQueryServiceImpl {
        -skinAnalysisRepository : SkinAnalysisRepository
        +SkinAnalysisQueryServiceImpl(skinAnalysisRepository : SkinAnalysisRepository)
        +handle(query : GetSkinAnalysisByIdQuery) : Optional<SkinAnalysis>
        +handle(query : GetSkinAnalysisByFacialScanIdQuery) : Optional<SkinAnalysis>
        +handle(query : GetSkinAnalysesByPatientIdQuery) : List<SkinAnalysis>
    }
    class SkinProfileQueryServiceImpl {
        -skinProfileRepository : SkinProfileRepository
        +SkinProfileQueryServiceImpl(skinProfileRepository : SkinProfileRepository)
        +handle(query : GetSkinProfileByIdQuery) : Optional<SkinProfile>
        +handle(query : GetSkinProfileByPatientIdQuery) : Optional<SkinProfile>
    }
}

package "queryservices" {
    interface FacialScanQueryService {
        +handle(query : GetFacialScanByIdQuery) : Optional<FacialScan>
        +handle(query : GetFacialScansByPatientIdQuery) : List<FacialScan>
    }
    interface SkinAnalysisQueryService {
        +handle(query : GetSkinAnalysisByIdQuery) : Optional<SkinAnalysis>
        +handle(query : GetSkinAnalysisByFacialScanIdQuery) : Optional<SkinAnalysis>
        +handle(query : GetSkinAnalysesByPatientIdQuery) : List<SkinAnalysis>
    }
    interface SkinProfileQueryService {
        +handle(query : GetSkinProfileByIdQuery) : Optional<SkinProfile>
        +handle(query : GetSkinProfileByPatientIdQuery) : Optional<SkinProfile>
    }
}

FacialScanCommandServiceImpl ..|> FacialScanCommandService
FacialScanCommandServiceImpl --> ExternalIamService : externalIamService
SkinAnalysisCommandServiceImpl ..|> SkinAnalysisCommandService
SkinProfileCommandServiceImpl ..|> SkinProfileCommandService
SkinProfileCommandServiceImpl --> ExternalIamService : externalIamService
FacialScanSubmittedEventHandler --> SkinProfileQueryService : skinProfileQueryService
FacialScanSubmittedEventHandler --> SkinAnalysisCommandService : skinAnalysisCommandService
FacialScanQueryServiceImpl ..|> FacialScanQueryService
SkinAnalysisQueryServiceImpl ..|> SkinAnalysisQueryService
SkinProfileQueryServiceImpl ..|> SkinProfileQueryService
@enduml