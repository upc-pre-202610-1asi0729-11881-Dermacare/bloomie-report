@startuml routinemanagement-application
!include https://raw.githubusercontent.com/upc-pre-202610-1asi0729-11881-dermacare/bloomie-report/refs/heads/main/assets/docs/_style.puml
title Routine Management — Application Layer

package "routinemanagement.domain (referenced)" as domain {
  class Routine
  class DailyTracking
  class PatientId <<value object>>
  class RoutineId <<value object>>
  enum RoutineStatus
  class GeneratePersonalizedRoutineCommand <<command>>
  class RemoveProductFromRoutineCommand <<command>>
  class ReplaceProductInRoutineCommand <<command>>
  class MarkRoutineAsCompletedCommand <<command>>
  class GetRoutineByIdQuery <<query>>
  class GetRoutineByPatientIdQuery <<query>>
  class GetRecommendedProductsForRoutineItemQuery <<query>>
  class GetAllDailyTrackingsQuery <<query>>
  class GetDailyTrackingByPatientIdAndDateQuery <<query>>
  class GetDailyTrackingsByPatientIdQuery <<query>>
  class GetDailyTrackingsByRoutineIdQuery <<query>>
  class GetWeeklySummaryByPatientIdQuery <<query>>
  class PersonalizedRoutineGeneratedEvent <<domain event>>
  interface RoutineRepository
  interface DailyTrackingRepository
}

package "routinemanagement.interfaces (referenced)" as ifaces {
  class PersonalizedRoutineGeneratedIntegrationEvent <<integration event>>
  class WeeklySummaryResource <<resource>>
}

package "skinanalysis bounded context (referenced)" as skinBc {
  class PreliminaryDiagnosisGeneratedIntegrationEvent <<integration event>>
}

package "routinemanagement.application" as application {

  package "commandservices\n(ports)" as cmdPorts {
    interface RoutineCommandService
    interface DailyTrackingCommandService
  }

  package "queryservices\n(ports)" as queryPorts {
    interface RoutineQueryService
    interface DailyTrackingQueryService
  }

  package "internal.outboundservices.ai\n(port)" as outbound {
    interface RoutineAiService {
      + selectProductsForRoutine(skinType, steps): Map<String,String>
      + selectAlternativeProductsForStep(skinType, step, current): List<String>
      + getCatalogProductsForStep(step): List<String>
    }
  }

  package "internal.commandservices\n(impl)" as cmdImpl {
    class RoutineCommandServiceImpl {
      - routineRepository: RoutineRepository
      - routineAiService: RoutineAiService
    }
    class DailyTrackingCommandServiceImpl {
      - dailyTrackingRepository: DailyTrackingRepository
      - routineQueryService: RoutineQueryService
    }
  }

  package "internal.queryservices\n(impl)" as queryImpl {
    class RoutineQueryServiceImpl {
      - routineRepository: RoutineRepository
      - routineAiService: RoutineAiService
    }
    class DailyTrackingQueryServiceImpl {
      - dailyTrackingRepository: DailyTrackingRepository
    }
  }

  package "internal.eventhandlers" as handlers {
    class PersonalizedRoutineGeneratedEventHandler {
      - eventPublisher: ApplicationEventPublisher
    }
    class PreliminaryDiagnosisGeneratedEventHandler {
      - routineCommandService: RoutineCommandService
    }
  }
}

