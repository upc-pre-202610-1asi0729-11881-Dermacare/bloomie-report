@startuml
title routinemanagement - domain
hide empty members
skinparam classAttributeIconSize 0

package "model.aggregates" {
    class DailyTracking {
        -id : Long
        -patientId : PatientId
        -routineId : RoutineId
        -date : LocalDate
        -completed : boolean
        -completedAt : LocalDateTime
        +DailyTracking()
        +DailyTracking(command : MarkRoutineAsCompletedCommand)
        +onCompleted() : void
    }
    class Routine {
        -id : Long
        -patientId : PatientId
        -skinAnalysisId : SkinAnalysisId
        -status : RoutineStatus
        -skinType : String
        -items : List<RoutineItem>
        -createdAt : LocalDateTime
        -MANDATORY_STEPS : List<String>
        +Routine()
        +Routine(command : GeneratePersonalizedRoutineCommand)
        -generateItemsForSkinType(skinType : String) : List<RoutineItem>
        +removeItem(command : RemoveProductFromRoutineCommand) : void
        +onGenerated() : void
        +replaceProduct(command : ReplaceProductInRoutineCommand) : void
        +setId(id : Long) : void
        +setPatientId(patientId : PatientId) : void
        +setSkinAnalysisId(skinAnalysisId : SkinAnalysisId) : void
        +setStatus(status : RoutineStatus) : void
        +setSkinType(skinType : String) : void
        +setItems(items : List<RoutineItem>) : void
        +setCreatedAt(createdAt : LocalDateTime) : void
        +getPatientId() : Long
        +getSkinAnalysisId() : Long
        +getPatientIdValue() : PatientId
        +getSkinAnalysisIdValue() : SkinAnalysisId
    }
}

package "model.commands" {
    class GeneratePersonalizedRoutineCommand << record >> {
        +patientId : Long
        +skinAnalysisId : Long
        +skinType : String
    }
    class MarkRoutineAsCompletedCommand << record >> {
        +patientId : Long
        +routineId : Long
        +date : LocalDate
    }
    class RemoveProductFromRoutineCommand << record >> {
        +routineId : Long
        +routineItemId : Long
    }
    class ReplaceProductInRoutineCommand << record >> {
        +routineId : Long
        +routineItemId : Long
        +newProductRecommendation : String
    }
}

package "model.entities" {
    class RoutineItem {
        -id : Long
        -step : String
        -order : Integer
        -scheduledTime : String
        -productRecommendation : String
        +RoutineItem(id : Long, step : String, order : Integer, scheduledTime : String, productRecommendation : String)
        +setId(id : Long) : void
        +updateProductRecommendation(newProductRecommendation : String) : void
    }
}

package "model.events" {
    class DailyRoutineCompletionRecordedEvent << record >> {
        +dailyTrackingId : Long
        +patientId : Long
        +routineId : Long
        +date : LocalDate
        +from(dailyTracking : DailyTracking) : DailyRoutineCompletionRecordedEvent
    }
    class PersonalizedRoutineGeneratedEvent << record >> {
        +routineId : Long
        +patientId : Long
        +skinAnalysisId : Long
        +from(routine : Routine) : PersonalizedRoutineGeneratedEvent
    }
    class ProductRemovedFromRoutineEvent << record >> {
        +routineId : Long
        +patientId : Long
        +routineItemId : Long
        +removedProduct : String
        +from(routine : Routine, routineItemId : Long, removedProduct : String) : ProductRemovedFromRoutineEvent
    }
    class ProductReplacedInRoutineEvent << record >> {
        +routineId : Long
        +patientId : Long
        +routineItemId : Long
        +previousProduct : String
        +newProduct : String
        +from(routine : Routine, routineItemId : Long, previousProduct : String, newProduct : String) : ProductReplacedInRoutineEvent
    }
}

package "model.queries" {
    class GetAllDailyTrackingsQuery << record >> {
    }
    class GetDailyTrackingByPatientIdAndDateQuery << record >> {
        +patientId : Long
        +date : LocalDate
    }
    class GetDailyTrackingsByPatientIdQuery << record >> {
        +patientId : Long
    }
    class GetDailyTrackingsByRoutineIdQuery << record >> {
        +routineId : Long
    }
    class GetRecommendedProductsForRoutineItemQuery << record >> {
        +routineId : Long
        +routineItemId : Long
    }
    class GetRoutineByIdQuery << record >> {
        +routineId : Long
    }
    class GetRoutineByPatientIdQuery << record >> {
        +patientId : Long
    }
    class GetWeeklySummaryByPatientIdQuery << record >> {
        +patientId : PatientId
    }
}

package "model.valueobjects" {
    class PatientId << record >> {
        +patientId : Long
    }
    class RoutineId << record >> {
        +routineId : Long
    }
    enum RoutineStatus {
        ACTIVE
        INACTIVE
    }
    class SkinAnalysisId << record >> {
        +skinAnalysisId : Long
    }
    enum TrackingStatus {
        COMPLETED
        NOT_COMPLETED
    }
}

package "repositories" {
    interface DailyTrackingRepository {
        +findById(id : Long) : Optional<DailyTracking>
        +findByPatientIdAndDate(patientId : PatientId, date : LocalDate) : Optional<DailyTracking>
        +findAllByPatientId(patientId : PatientId) : List<DailyTracking>
        +findAllByRoutineId(routineId : RoutineId) : List<DailyTracking>
        +findAll() : List<DailyTracking>
        +save(dailyTracking : DailyTracking) : DailyTracking
        +existsByPatientIdAndDate(patientId : PatientId, date : LocalDate) : boolean
    }
    interface RoutineRepository {
        +findById(id : Long) : Optional<Routine>
        +findActiveByPatientId(patientId : PatientId) : Optional<Routine>
        +save(routine : Routine) : Routine
        +existsByPatientId(patientId : PatientId) : boolean
    }
}

DailyTracking --> PatientId : patientId
DailyTracking --> RoutineId : routineId
DailyTracking ..> MarkRoutineAsCompletedCommand
Routine --> PatientId : patientId
Routine --> SkinAnalysisId : skinAnalysisId
Routine --> RoutineStatus : status
Routine --> RoutineItem : items
Routine ..> GeneratePersonalizedRoutineCommand
Routine ..> RemoveProductFromRoutineCommand
Routine ..> ReplaceProductInRoutineCommand
DailyRoutineCompletionRecordedEvent ..> DailyTracking
PersonalizedRoutineGeneratedEvent ..> Routine
ProductRemovedFromRoutineEvent ..> Routine
ProductReplacedInRoutineEvent ..> Routine
GetWeeklySummaryByPatientIdQuery --> PatientId : patientId
DailyTrackingRepository ..> DailyTracking
DailyTrackingRepository ..> PatientId
DailyTrackingRepository ..> RoutineId
RoutineRepository ..> Routine
RoutineRepository ..> PatientId
@enduml