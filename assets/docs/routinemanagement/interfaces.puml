@startuml
title routinemanagement - interfaces
hide empty members
skinparam classAttributeIconSize 0

package "events" {
    class PersonalizedRoutineGeneratedIntegrationEvent << record >> {
        +routineId : Long
        +patientId : Long
        +skinAnalysisId : Long
    }
}

package "rest" {
    class DailyTrackingController {
        -dailyTrackingCommandService : DailyTrackingCommandService
        -dailyTrackingQueryService : DailyTrackingQueryService
        +DailyTrackingController(dailyTrackingCommandService : DailyTrackingCommandService, dailyTrackingQueryService : DailyTrackingQueryService)
    }
    class RoutineController {
        -routineQueryService : RoutineQueryService
        -routineCommandService : RoutineCommandService
        +RoutineController(routineQueryService : RoutineQueryService, routineCommandService : RoutineCommandService)
    }
}

package "rest.resources" {
    class DailyTrackingResource << record >> {
        +id : Long
        +patientId : Long
        +routineId : Long
        +date : String
        +isCompleted : boolean
        +completedAt : String
    }
    class MarkRoutineAsCompletedResource << record >> {
        +patientId : Long
        +routineId : Long
        +date : String
    }
    class ReplaceProductInRoutineResource << record >> {
        +newProductRecommendation : String
    }
    class RoutineItemResource << record >> {
        +id : Long
        +step : String
        +order : Integer
        +scheduledTime : String
        +productRecommendation : String
    }
    class RoutineResource << record >> {
        +id : Long
        +patientId : Long
        +skinAnalysisId : Long
        +status : String
        +createdAt : String
        +items : List<RoutineItemResource>
    }
    class WeeklySummaryResource << record >> {
        +patientId : Long
        +weekStart : String
        +weekEnd : String
        +completedDays : int
        +missedDays : int
        +completionRate : Double
    }
}

package "rest.transform" {
    class DailyTrackingResourceFromEntityAssembler {
        -DailyTrackingResourceFromEntityAssembler()
        +toResourceFromEntity(tracking : DailyTracking) : DailyTrackingResource
    }
    class MarkRoutineAsCompletedCommandFromResourceAssembler {
        -MarkRoutineAsCompletedCommandFromResourceAssembler()
        +toCommandFromResource(resource : MarkRoutineAsCompletedResource) : MarkRoutineAsCompletedCommand
    }
    class ReplaceProductInRoutineCommandFromResourceAssembler {
        +toCommandFromResource(routineId : Long, routineItemId : Long, resource : ReplaceProductInRoutineResource) : ReplaceProductInRoutineCommand
    }
    class RoutineResourceFromEntityAssembler {
        -RoutineResourceFromEntityAssembler()
        +toResourceFromEntity(routine : Routine) : RoutineResource
    }
}

RoutineResource --> RoutineItemResource : items
DailyTrackingResourceFromEntityAssembler ..> DailyTrackingResource
MarkRoutineAsCompletedCommandFromResourceAssembler ..> MarkRoutineAsCompletedResource
ReplaceProductInRoutineCommandFromResourceAssembler ..> ReplaceProductInRoutineResource
RoutineResourceFromEntityAssembler ..> RoutineResource
@enduml