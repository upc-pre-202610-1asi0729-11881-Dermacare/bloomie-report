@startuml
title routinemanagement - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "ai.services" {
    class GeminiRoutineAiServiceImpl {
        -PRODUCT_CATALOG : String
        -CATALOG_BY_STEP : Map<String,List<String>>
        -apiKey : String
        -apiUrl : String
        -restTemplate : RestTemplate
        -objectMapper : ObjectMapper
        -parseCatalog(catalog : String) : Map<String,List<String>>
        +GeminiRoutineAiServiceImpl()
        +selectProductsForRoutine(skinType : String, steps : List<String>) : Map<String,String>
        -buildPrompt(skinType : String, steps : List<String>) : String
        -parseResponse(responseBody : String, steps : List<String>, skinType : String) : Map<String,String>
        +getCatalogProductsForStep(step : String) : List<String>
        +selectAlternativeProductsForStep(skinType : String, step : String, currentProduct : String) : List<String>
        -buildAlternativesPrompt(skinType : String, step : String, currentProduct : String) : String
        -parseAlternativesResponse(responseBody : String, step : String, currentProduct : String) : List<String>
        -fallbackAlternatives(step : String, currentProduct : String) : List<String>
        -fallbackProducts(skinType : String, steps : List<String>) : Map<String,String>
    }
}

package "persistence.jpa.adapters" {
    class DailyTrackingRepositoryImpl {
        -dailyTrackingPersistenceRepository : DailyTrackingPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +DailyTrackingRepositoryImpl(dailyTrackingPersistenceRepository : DailyTrackingPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<DailyTracking>
        +findByPatientIdAndDate(patientId : PatientId, date : LocalDate) : Optional<DailyTracking>
        +findAllByPatientId(patientId : PatientId) : List<DailyTracking>
        +findAllByRoutineId(routineId : RoutineId) : List<DailyTracking>
        +findAll() : List<DailyTracking>
        +save(dailyTracking : DailyTracking) : DailyTracking
        +existsByPatientIdAndDate(patientId : PatientId, date : LocalDate) : boolean
    }
    class RoutineRepositoryImpl {
        -routinePersistenceRepository : RoutinePersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +RoutineRepositoryImpl(routinePersistenceRepository : RoutinePersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<Routine>
        +findActiveByPatientId(patientId : PatientId) : Optional<Routine>
        +save(routine : Routine) : Routine
        +existsByPatientId(patientId : PatientId) : boolean
    }
}

package "persistence.jpa.assemblers" {
    class DailyTrackingPersistenceAssembler {
        -DailyTrackingPersistenceAssembler()
        +toDomainFromPersistence(entity : DailyTrackingPersistenceEntity) : DailyTracking
        +toPersistenceFromDomain(tracking : DailyTracking) : DailyTrackingPersistenceEntity
    }
    class RoutinePersistenceAssembler {
        -RoutinePersistenceAssembler()
        +toDomainFromPersistence(entity : RoutinePersistenceEntity) : Routine
        +toPersistenceFromDomain(routine : Routine) : RoutinePersistenceEntity
        -toItemsDomainFromPersistence(itemEntities : List<RoutineItemPersistenceEntity>, routineEntity : RoutinePersistenceEntity) : List<RoutineItem>
    }
}

package "persistence.jpa.converters" {
    class PatientIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PatientId) : Long
        +convertToEntityAttribute(dbData : Long) : PatientId
    }
    class RoutineIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : RoutineId) : Long
        +convertToEntityAttribute(dbData : Long) : RoutineId
    }
    class SkinAnalysisIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : SkinAnalysisId) : Long
        +convertToEntityAttribute(dbData : Long) : SkinAnalysisId
    }
}

package "persistence.jpa.entities" {
    class DailyTrackingPersistenceEntity {
        -patientId : PatientId
        -routineId : RoutineId
        -date : LocalDate
        -completed : boolean
        -completedAt : LocalDateTime
    }
    class RoutineItemPersistenceEntity {
        -routine : RoutinePersistenceEntity
        -step : String
        -order : Integer
        -scheduledTime : String
        -productRecommendation : String
    }
    class RoutinePersistenceEntity {
        -patientId : PatientId
        -skinAnalysisId : SkinAnalysisId
        -status : RoutineStatus
        -skinType : String
        -items : List<RoutineItemPersistenceEntity>
    }
}

package "persistence.jpa.repositories" {
    interface DailyTrackingPersistenceRepository {
        +findByPatientIdAndDate(patientId : PatientId, date : LocalDate) : Optional<DailyTrackingPersistenceEntity>
        +findAllByPatientId(patientId : PatientId) : List<DailyTrackingPersistenceEntity>
        +findAllByRoutineId(routineId : RoutineId) : List<DailyTrackingPersistenceEntity>
        +existsByPatientIdAndDate(patientId : PatientId, date : LocalDate) : boolean
    }
    interface RoutinePersistenceRepository {
        +findByPatientIdAndStatus(patientId : PatientId, status : RoutineStatus) : Optional<RoutinePersistenceEntity>
        +existsByPatientId(patientId : PatientId) : boolean
        +findById(id : Long) : Optional<RoutinePersistenceEntity>
    }
}

DailyTrackingRepositoryImpl --> DailyTrackingPersistenceRepository : dailyTrackingPersistenceRepository
RoutineRepositoryImpl --> RoutinePersistenceRepository : routinePersistenceRepository
DailyTrackingPersistenceAssembler ..> DailyTrackingPersistenceEntity
RoutinePersistenceAssembler ..> RoutinePersistenceEntity
RoutinePersistenceAssembler ..> RoutineItemPersistenceEntity
RoutineItemPersistenceEntity --> RoutinePersistenceEntity : routine
RoutinePersistenceEntity --> RoutineItemPersistenceEntity : items
DailyTrackingPersistenceRepository ..> DailyTrackingPersistenceEntity
RoutinePersistenceRepository ..> RoutinePersistenceEntity
@enduml