@startuml
title routinemanagement - application
hide empty members
skinparam classAttributeIconSize 0

package "commandservices" {
    interface DailyTrackingCommandService {
        +handle(command : MarkRoutineAsCompletedCommand) : Result<Long,ApplicationError>
    }
    interface RoutineCommandService {
        +handle(command : GeneratePersonalizedRoutineCommand) : Result<Long,ApplicationError>
        +handle(command : ReplaceProductInRoutineCommand) : Result<Routine,ApplicationError>
        +handle(command : RemoveProductFromRoutineCommand) : Result<Routine,ApplicationError>
    }
}

package "internal.commandservices" {
    class DailyTrackingCommandServiceImpl {
        -dailyTrackingRepository : DailyTrackingRepository
        -routineQueryService : RoutineQueryService
        +DailyTrackingCommandServiceImpl(dailyTrackingRepository : DailyTrackingRepository, routineQueryService : RoutineQueryService)
        +handle(command : MarkRoutineAsCompletedCommand) : Result<Long,ApplicationError>
    }
    class RoutineCommandServiceImpl {
        -routineRepository : RoutineRepository
        -routineAiService : RoutineAiService
        +RoutineCommandServiceImpl(routineRepository : RoutineRepository, routineAiService : RoutineAiService)
        +handle(command : GeneratePersonalizedRoutineCommand) : Result<Long,ApplicationError>
        +handle(command : RemoveProductFromRoutineCommand) : Result<Routine,ApplicationError>
        +handle(command : ReplaceProductInRoutineCommand) : Result<Routine,ApplicationError>
    }
}

package "internal.eventhandlers" {
    class PersonalizedRoutineGeneratedEventHandler {
        -eventPublisher : ApplicationEventPublisher
        +PersonalizedRoutineGeneratedEventHandler(eventPublisher : ApplicationEventPublisher)
        +on(event : PersonalizedRoutineGeneratedEvent) : void
    }
    class PreliminaryDiagnosisGeneratedEventHandler {
        -routineCommandService : RoutineCommandService
        +PreliminaryDiagnosisGeneratedEventHandler(routineCommandService : RoutineCommandService)
        +on(event : PreliminaryDiagnosisGeneratedIntegrationEvent) : void
    }
}

package "internal.outboundservices.ai" {
    interface RoutineAiService {
        +selectProductsForRoutine(skinType : String, steps : List<String>) : Map<String,String>
        +selectAlternativeProductsForStep(skinType : String, step : String, currentProduct : String) : List<String>
        +getCatalogProductsForStep(step : String) : List<String>
    }
}

package "internal.queryservices" {
    class DailyTrackingQueryServiceImpl {
        -dailyTrackingRepository : DailyTrackingRepository
        +DailyTrackingQueryServiceImpl(dailyTrackingRepository : DailyTrackingRepository)
        +handle(query : GetAllDailyTrackingsQuery) : List<DailyTracking>
        +handle(query : GetDailyTrackingByPatientIdAndDateQuery) : Optional<DailyTracking>
        +handle(query : GetDailyTrackingsByPatientIdQuery) : List<DailyTracking>
        +handle(query : GetDailyTrackingsByRoutineIdQuery) : List<DailyTracking>
        +handle(query : GetWeeklySummaryByPatientIdQuery) : WeeklySummaryResource
    }
    class RoutineQueryServiceImpl {
        -routineRepository : RoutineRepository
        -routineAiService : RoutineAiService
        +RoutineQueryServiceImpl(routineRepository : RoutineRepository, routineAiService : RoutineAiService)
        +handle(query : GetRoutineByIdQuery) : Optional<Routine>
        +handle(query : GetRoutineByPatientIdQuery) : Optional<Routine>
        +handle(query : GetRecommendedProductsForRoutineItemQuery) : List<String>
    }
}

package "queryservices" {
    interface DailyTrackingQueryService {
        +handle(query : GetAllDailyTrackingsQuery) : List<DailyTracking>
        +handle(query : GetDailyTrackingByPatientIdAndDateQuery) : Optional<DailyTracking>
        +handle(query : GetDailyTrackingsByPatientIdQuery) : List<DailyTracking>
        +handle(query : GetDailyTrackingsByRoutineIdQuery) : List<DailyTracking>
        +handle(query : GetWeeklySummaryByPatientIdQuery) : WeeklySummaryResource
    }
    interface RoutineQueryService {
        +handle(query : GetRoutineByIdQuery) : Optional<Routine>
        +handle(query : GetRoutineByPatientIdQuery) : Optional<Routine>
        +handle(query : GetRecommendedProductsForRoutineItemQuery) : List<String>
    }
}

DailyTrackingCommandServiceImpl ..|> DailyTrackingCommandService
DailyTrackingCommandServiceImpl --> RoutineQueryService : routineQueryService
RoutineCommandServiceImpl ..|> RoutineCommandService
RoutineCommandServiceImpl --> RoutineAiService : routineAiService
PreliminaryDiagnosisGeneratedEventHandler --> RoutineCommandService : routineCommandService
DailyTrackingQueryServiceImpl ..|> DailyTrackingQueryService
RoutineQueryServiceImpl ..|> RoutineQueryService
RoutineQueryServiceImpl --> RoutineAiService : routineAiService
@enduml