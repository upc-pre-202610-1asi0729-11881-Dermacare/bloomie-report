}

package "dermatologicalappointment.interfaces" as ifaces {

  package acl {
    interface DermatologicalAppointmentContextFacade {
      + existsAppointmentByPatientId(id: Long): boolean
      + fetchAppointmentStatusById(id: Long): String
    }
  }

  package events {
    class ProcessRefundIntegrationEvent <<integration event>> { + appointmentId: Long\n+ patientId: Long }
    class RequestConsultationPaymentIntegrationEvent <<integration event>> {
      + appointmentId: Long\n+ patientId: Long\n+ dermatologistId: Long\n+ scheduledAt: String\n+ amount: Double
    }
  }

  package rest {
    class AppointmentController {
      - queryService: AppointmentQueryService
      - commandService: AppointmentCommandService
    }
    class ConsultationController {
      - queryService: ConsultationQueryService
      - commandService: ConsultationCommandService
    }
  }

  package "rest.resources" as resources {
    class AppointmentResource <<resource>>
    class ScheduleAppointmentResource <<resource>>
    class CancelAppointmentResource <<resource>>
    class ConfirmAppointmentResource <<resource>>
    class ReprogramRequestResource <<resource>>
