    class StartConsultationResource <<resource>>
    class SaveNotesResource <<resource>>
    class RecordDiagnosisResource <<resource>>
    class UploadClinicalPhotoResource <<resource>>
    class FinishConsultationResource <<resource>>
  }

  package "rest.transform" as transform {
    class AppointmentResourceFromEntityAssembler <<static assembler>>
    class ScheduleAppointmentCommandFromResourceAssembler <<static assembler>>
    class CancelAppointmentCommandFromResourceAssembler <<static assembler>>
