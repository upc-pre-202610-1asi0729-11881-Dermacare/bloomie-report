@startuml
title iam - domain
hide empty members
skinparam classAttributeIconSize 0

package "model.aggregates" {
    class User {
        -id : Long
        -name : PersonName
        -emailAddress : EmailAddress
        -hashedPassword : HashedPassword
        -photoUrl : String
        -roles : Set<Role>
        +User(id : Long, name : PersonName, email : EmailAddress, hashedPassword : HashedPassword, roles : Set<Role>, photoUrl : String)
        +User(id : Long, name : PersonName, email : EmailAddress, hashedPassword : HashedPassword, roles : Set<Role>)
        +User(name : PersonName, email : EmailAddress, hashedPassword : HashedPassword, roles : Set<Role>)
        +User(firstName : String, lastName : String, email : String, hashedPassword : String, roles : List<Role>)
        +User(command : RegisterUserCommand, role : Role)
        +onRegistered() : void
        +User(command : RegisterDermatologistCommand, role : Role)
        +onDermatologistRegistered() : void
        +updateProfile(command : UpdateUserProfileCommand) : void
        +onProfileUpdate() : void
        +updatePhoto(command : UpdateUserPhotoCommand) : void
        +onPhotoUpdated() : void
        +changePassword(command : ChangePasswordCommand) : void
        +onPasswordChanged() : void
        +addRole(role : Role) : User
        +addRoles(roles : List<Role>) : User
        +getName() : PersonName
        +getEmailAddressValue() : EmailAddress
        +getHashedPassword() : HashedPassword
        +getPhotoUrl() : String
        +getRoles() : Set<Role>
        +getFullName() : String
        +getEmail() : String
        +getPassword() : String
    }
}

package "model.commands" {
    class ChangePasswordCommand << record >> {
        +userId : String
        +currentPassword : String
        +newPassword : String
    }
    class RegisterDermatologistCommand << record >> {
        +email : String
        +password : String
        +firstName : String
        +lastName : String
    }
    class RegisterUserCommand << record >> {
        +email : String
        +password : String
        +firstName : String
        +lastName : String
    }
    class SeedRolesCommand << record >> {
    }
    class SignInCommand << record >> {
        +email : String
        +password : String
    }
    class UpdateUserPhotoCommand << record >> {
        +userId : Long
        +photoUrl : String
    }
    class UpdateUserProfileCommand << record >> {
        +userId : String
        +firstName : String
        +lastName : String
        +email : String
    }
}

package "model.entities" {
    class Role {
        -id : Long
        -name : UserRole
        +Role()
        +Role(name : UserRole)
        +Role(id : Long, name : UserRole)
        +getId() : Long
        +getName() : UserRole
        +getStringName() : String
        +getDefaultRole() : Role
        +toRoleFromName(name : String) : Role
        +validateRoleSet(roles : List<Role>) : List<Role>
    }
}

package "model.events" {
    class DermatologistRegisteredEvent << record >> {
        +userId : Long
        +firstName : String
        +lastName : String
        +email : String
        +from(user : User) : DermatologistRegisteredEvent
    }
    class PasswordChangedEvent << record >> {
        +userId : Long
        +from(user : User) : PasswordChangedEvent
    }
    class UserLoggedInEvent << record >> {
        +userId : Long
        +email : String
        +from(user : User) : UserLoggedInEvent
    }
    class UserPhotoUpdatedEvent << record >> {
        +userId : Long
        +photoUrl : String
        +from(user : User) : UserPhotoUpdatedEvent
    }
    class UserProfileUpdatedEvent << record >> {
        +userId : Long
        +email : String
        +from(user : User) : UserProfileUpdatedEvent
    }
    class UserRegisteredEvent << record >> {
        +userId : Long
        +email : String
        +from(user : User) : UserRegisteredEvent
    }
}

package "model.queries" {
    class GetAllUsersQuery << record >> {
    }
    class GetUserByEmailQuery << record >> {
        +email : String
    }
    class GetUserByIdQuery << record >> {
        +userId : Long
    }
}

package "model.valueobjects" {
    class EmailAddress << record >> {
        +address : String
        +getAddress() : String
    }
    class HashedPassword << record >> {
        +hashedPassword : String
        +value() : String
    }
    class PersonName << record >> {
        +firstName : String
        +lastName : String
        +getFullName() : String
    }
    enum UserRole {
        ROLE_YOUNG_ADULT
        ROLE_DERMATOLOGIST
    }
}

package "repositories" {
    interface RoleRepository {
        +findByName(name : UserRole) : Optional<Role>
        +findAll() : List<Role>
        +save(role : Role) : Role
        +existsByName(name : UserRole) : boolean
    }
    interface UserRepository {
        +findById(id : Long) : Optional<User>
        +findByEmailAddress(emailAddress : EmailAddress) : Optional<User>
        +findAll() : List<User>
        +save(user : User) : User
        +existsByEmailAddress(emailAddress : EmailAddress) : boolean
    }
}

User --> PersonName : name
User --> EmailAddress : emailAddress
User --> HashedPassword : hashedPassword
User --> Role : roles
User ..> RegisterUserCommand
User ..> RegisterDermatologistCommand
User ..> UpdateUserProfileCommand
User ..> UpdateUserPhotoCommand
User ..> ChangePasswordCommand
Role --> UserRole : name
DermatologistRegisteredEvent ..> User
PasswordChangedEvent ..> User
UserLoggedInEvent ..> User
UserPhotoUpdatedEvent ..> User
UserProfileUpdatedEvent ..> User
UserRegisteredEvent ..> User
RoleRepository ..> UserRole
RoleRepository ..> Role
UserRepository ..> User
UserRepository ..> EmailAddress
@enduml