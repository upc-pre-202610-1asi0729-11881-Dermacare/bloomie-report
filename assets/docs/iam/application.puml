@startuml
title iam - application
hide empty members
skinparam classAttributeIconSize 0

package "acl" {
    class IamContextFacadeImpl {
        -userQueryService : UserQueryService
        +IamContextFacadeImpl(userQueryService : UserQueryService)
        +fetchUserByEmail(email : String) : Long
        +existsUserByEmail(email : String) : boolean
        +existsUserById(userId : Long) : boolean
        +fetchUserPhotoUrl(userId : Long) : String
    }
}

package "commandservices" {
    interface RoleCommandService {
        +handle(command : SeedRolesCommand) : void
    }
    interface UserCommandService {
        +handle(command : SignInCommand) : Result<ImmutablePair<User,String>,ApplicationError>
        +handle(command : RegisterUserCommand) : Result<User,ApplicationError>
        +handle(command : RegisterDermatologistCommand) : Result<User,ApplicationError>
        +handle(command : UpdateUserProfileCommand) : Result<User,ApplicationError>
        +handle(command : UpdateUserPhotoCommand) : Result<User,ApplicationError>
        +handle(command : ChangePasswordCommand) : Result<Void,ApplicationError>
    }
}

package "internal.commandservices" {
    class RoleCommandServiceImpl {
        -roleRepository : RoleRepository
        +RoleCommandServiceImpl(roleRepository : RoleRepository)
        +handle(command : SeedRolesCommand) : void
    }
    class UserCommandServiceImpl {
        -userRepository : UserRepository
        -roleRepository : RoleRepository
        -hashingService : HashingService
        -tokenService : TokenService
        -EMAIL_ALREADY_REGISTERED : String
        -USER_NOT_FOUND : String
        -INVALID_CREDENTIALS : String
        -INVALID_PASSWORD : String
        -ROLE_NOT_FOUND : String
        +UserCommandServiceImpl(userRepository : UserRepository, roleRepository : RoleRepository, hashingService : HashingService, tokenService : TokenService)
        +handle(command : SignInCommand) : Result<ImmutablePair<User,String>,ApplicationError>
        +handle(command : RegisterUserCommand) : Result<User,ApplicationError>
        +handle(command : RegisterDermatologistCommand) : Result<User,ApplicationError>
        +handle(command : UpdateUserProfileCommand) : Result<User,ApplicationError>
        +handle(command : UpdateUserPhotoCommand) : Result<User,ApplicationError>
        +handle(command : ChangePasswordCommand) : Result<Void,ApplicationError>
    }
}

package "internal.eventhandlers" {
    class ApplicationReadyEventHandler {
        -roleCommandService : RoleCommandService
        +ApplicationReadyEventHandler(roleCommandService : RoleCommandService)
        +on(event : ApplicationReadyEvent) : void
        -currentTimestamp() : Timestamp
    }
    class DermatologistRegisteredEventHandler {
        -eventPublisher : ApplicationEventPublisher
        +DermatologistRegisteredEventHandler(eventPublisher : ApplicationEventPublisher)
        +on(event : DermatologistRegisteredEvent) : void
    }
}

package "internal.outboundservices.hashing" {
    interface HashingService {
        +encode(rawPassword : CharSequence) : String
        +matches(rawPassword : CharSequence, encodedPassword : String) : boolean
    }
}

package "internal.outboundservices.tokens" {
    interface TokenService {
        +generateToken(username : String) : String
        +getUsernameFromToken(token : String) : String
        +validateToken(token : String) : boolean
    }
}

package "internal.queryservices" {
    class UserQueryServiceImpl {
        -userRepository : UserRepository
        +UserQueryServiceImpl(userRepository : UserRepository)
        +handle(query : GetUserByIdQuery) : Optional<User>
        +handle(query : GetUserByEmailQuery) : Optional<User>
        +handle(query : GetAllUsersQuery) : List<User>
    }
}

package "queryservices" {
    interface UserQueryService {
        +handle(query : GetUserByIdQuery) : Optional<User>
        +handle(query : GetUserByEmailQuery) : Optional<User>
        +handle(query : GetAllUsersQuery) : List<User>
    }
}

IamContextFacadeImpl --> UserQueryService : userQueryService
RoleCommandServiceImpl ..|> RoleCommandService
UserCommandServiceImpl ..|> UserCommandService
UserCommandServiceImpl --> HashingService : hashingService
UserCommandServiceImpl --> TokenService : tokenService
ApplicationReadyEventHandler --> RoleCommandService : roleCommandService
UserQueryServiceImpl ..|> UserQueryService
@enduml