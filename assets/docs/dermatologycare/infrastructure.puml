@startuml
title dermatologycare - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "persistence.jpa.adapters" {
    class AvailabilityRepositoryImpl {
        -persistenceRepository : AvailabilityPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +AvailabilityRepositoryImpl(persistenceRepository : AvailabilityPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<Availability>
        +findAllByDermatologistId(dermatologistId : DermatologistId) : List<Availability>
        +findAllByDermatologistAndDay(dermatologistId : DermatologistId, day : DayOfWeek) : List<Availability>
        +save(availability : Availability) : Availability
        +existsByDermatologyAndDay(dermatologistId : DermatologistId, day : DayOfWeek) : boolean
    }
    class DermatologistProfileRepositoryImpl {
        -persistenceRepository : DermatologistProfilePersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +DermatologistProfileRepositoryImpl(persistenceRepository : DermatologistProfilePersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<DermatologistProfile>
        +findByDermatologistId(dermatologistId : DermatologistId) : Optional<DermatologistProfile>
        +findAll() : List<DermatologistProfile>
        +save(profile : DermatologistProfile) : DermatologistProfile
        +existsByDermatologistId(dermatologistId : DermatologistId) : boolean
    }
}

package "persistence.jpa.assemblers" {
    class AvailabilityPersistenceAssembler {
        -AvailabilityPersistenceAssembler()
        +toDomainFromPersistence(entity : AvailabilityPersistenceEntity) : Availability
        +toPersistenceFromDomain(availability : Availability) : AvailabilityPersistenceEntity
        -toDomainFromPersistence(value : TimeSlotPersistenceEmbeddable) : TimeSlot
        -toPersistenceFromDomain(value : TimeSlot) : TimeSlotPersistenceEmbeddable
    }
    class DermatologistProfilePersistenceAssembler {
        -DermatologistProfilePersistenceAssembler()
        +toDomainFromPersistence(entity : DermatologistProfilePersistenceEntity) : DermatologistProfile
        +toPersistenceFromDomain(profile : DermatologistProfile) : DermatologistProfilePersistenceEntity
        -toDomainFromPersistence(value : PersonNamePersistenceEmbeddable) : PersonName
        -toPersistenceFromDomain(value : PersonName) : PersonNamePersistenceEmbeddable
    }
}

package "persistence.jpa.converters" {
    class ContactPhonePersistenceConverter {
        +convertToDatabaseColumn(attribute : ContactPhone) : String
        +convertToEntityAttribute(dbData : String) : ContactPhone
    }
    class DermatologistIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : DermatologistId) : Long
        +convertToEntityAttribute(dbData : Long) : DermatologistId
    }
    class LicenseNumberPersistenceConverter {
        +convertToDatabaseColumn(attribute : LicenseNumber) : String
        +convertToEntityAttribute(dbData : String) : LicenseNumber
    }
    class SpecialtyNamePersistenceConverter {
        +convertToDatabaseColumn(attribute : SpecialtyName) : String
        +convertToEntityAttribute(dbData : String) : SpecialtyName
    }
}

package "persistence.jpa.embeddables" {
    class PersonNamePersistenceEmbeddable {
        -firstName : String
        -lastName : String
        +PersonNamePersistenceEmbeddable()
        +PersonNamePersistenceEmbeddable(firstName : String, lastName : String)
        +getFirstName() : String
        +setFirstName(firstName : String) : void
        +getLastName() : String
        +setLastName(lastName : String) : void
    }
    class TimeSlotPersistenceEmbeddable {
        -startTime : LocalTime
        -endTime : LocalTime
        +TimeSlotPersistenceEmbeddable()
        +TimeSlotPersistenceEmbeddable(startTime : LocalTime, endTime : LocalTime)
        +getStartTime() : LocalTime
        +setStartTime(startTime : LocalTime) : void
        +getEndTime() : LocalTime
        +setEndTime(endTime : LocalTime) : void
    }
}

package "persistence.jpa.entities" {
    class AvailabilityPersistenceEntity {
        -dermatologistId : DermatologistId
        -day : DayOfWeek
    }
    class DermatologistProfilePersistenceEntity {
    }
}

package "persistence.jpa.repositories" {
    interface AvailabilityPersistenceRepository {
        +findAllByDermatologistId(dermatologistId : DermatologistId) : List<AvailabilityPersistenceEntity>
        +findAllByDermatologistIdAndDay(dermatologistId : DermatologistId, day : DayOfWeek) : List<AvailabilityPersistenceEntity>
    }
    interface DermatologistProfilePersistenceRepository {
        +findByDermatologistId(dermatologistId : DermatologistId) : Optional<DermatologistProfilePersistenceEntity>
    }
}

AvailabilityRepositoryImpl --> AvailabilityPersistenceRepository : persistenceRepository
DermatologistProfileRepositoryImpl --> DermatologistProfilePersistenceRepository : persistenceRepository
AvailabilityPersistenceAssembler ..> AvailabilityPersistenceEntity
AvailabilityPersistenceAssembler ..> TimeSlotPersistenceEmbeddable
DermatologistProfilePersistenceAssembler ..> DermatologistProfilePersistenceEntity
DermatologistProfilePersistenceAssembler ..> PersonNamePersistenceEmbeddable
AvailabilityPersistenceRepository ..> AvailabilityPersistenceEntity
DermatologistProfilePersistenceRepository ..> DermatologistProfilePersistenceEntity
@enduml