@startuml dermatologycare-application
!include ../_style.puml
title Dermatology Care — Application Layer

package "dermatologycare.domain (referenced)" as domain {
  class Availability
  class DermatologistProfile
  class DermatologistId <<value object>>
  class DefineAvailabilityCommand <<command>>
  class UpdateAvailabilityCommand <<command>>
  class RegisterDermatologistProfileCommand <<command>>
  class UpdateDermatologistProfileCommand <<command>>
  class GetAvailabilityByDermatologistIdQuery <<query>>
  class GetAvailabilityByDermatologistIdAndDayQuery <<query>>
  class GetAllDermatologistProfilesQuery <<query>>
  class GetDermatologistProfileByDermatologistIdQuery <<query>>
  class GetDermatologistProfileByIdQuery <<query>>
  class AvailabilityDefinedEvent <<domain event>>
  interface AvailabilityRepository
  interface DermatologistProfileRepository
}

package "dermatologycare.interfaces (referenced)" as ifaces {
  interface DermatologyCareContextFacade
  class AvailabilityDefinedIntegrationEvent <<integration event>>
}

package "iam bounded context (referenced)" as iamBc {
  interface IamContextFacade
  class DermatologistRegisteredIntegrationEvent <<integration event>>
}

package "dermatologycare.application" as application {

  package "commandservices\n(ports)" as cmdPorts {
    interface AvailabilityCommandService {
      + handle(c: DefineAvailabilityCommand): Result<Availability,ApplicationError>
      + handle(c: UpdateAvailabilityCommand): Result<Availability,ApplicationError>
    }
    interface DermatologistProfileCommandService {
      + handle(c: RegisterDermatologistProfileCommand): Result<Long,ApplicationError>
      + handle(c: UpdateDermatologistProfileCommand): Result<DermatologistProfile,ApplicationError>
    }
  }

  package "queryservices\n(ports)" as queryPorts {
    interface AvailabilityQueryService {
      + handle(q: GetAvailabilityByDermatologistIdQuery): List<Availability>
      + handle(q: GetAvailabilityByDermatologistIdAndDayQuery): List<Availability>
    }
    interface DermatologistProfileQueryService {
      + handle(q: GetDermatologistProfileByIdQuery): Optional<DermatologistProfile>
      + handle(q: GetDermatologistProfileByDermatologistIdQuery): Optional<DermatologistProfile>
      + handle(q: GetAllDermatologistProfilesQuery): List<DermatologistProfile>
    }
  }

  package "internal.commandservices\n(impl)" as cmdImpl {
    class AvailabilityCommandServiceImpl {
      - availabilityRepository: AvailabilityRepository
    }
    class DermatologistProfileCommandServiceImpl {
      - dermatologistProfileRepository: DermatologistProfileRepository
    }
  }

  package "internal.queryservices\n(impl)" as queryImpl {
    class AvailabilityQueryServiceImpl {
      - availabilityRepository: AvailabilityRepository
    }
    class DermatologistProfileQueryServiceImpl {
      - dermatologistProfileRepository: DermatologistProfileRepository
    }
  }

  package "internal.eventhandlers" as handlers {
    class AvailabilityDefinedEventHandler {
      - eventPublisher: ApplicationEventPublisher
      + on(event: AvailabilityDefinedEvent)
    }
    class DermatologistRegisteredEventHandler {
      - dermatologistProfileCommandService: DermatologistProfileCommandService
      + on(event: DermatologistRegisteredIntegrationEvent)
    }
  }

  package "internal.outboundservices.acl" as outbound {
    class ExternalIamService {
      - iamContextFacade: IamContextFacade
      + fetchDermatologistById(userId: Long): Optional<DermatologistId>
      + fetchDermatologistByEmail(email: String): Optional<DermatologistId>
    }
  }

  package acl {
    class DermatologyCareContextFacadeImpl {
      - profileQueryService: DermatologistProfileQueryService
    }
  }
}

AvailabilityCommandServiceImpl ..|> AvailabilityCommandService
DermatologistProfileCommandServiceImpl ..|> DermatologistProfileCommandService
AvailabilityQueryServiceImpl ..|> AvailabilityQueryService
DermatologistProfileQueryServiceImpl ..|> DermatologistProfileQueryService
DermatologyCareContextFacadeImpl ..> DermatologyCareContextFacade : <<implements>>

AvailabilityCommandServiceImpl ..> AvailabilityRepository : <<uses>>
AvailabilityCommandServiceImpl ..> Availability : <<uses>>
AvailabilityCommandServiceImpl ..> DefineAvailabilityCommand : <<uses>>
AvailabilityCommandServiceImpl ..> UpdateAvailabilityCommand : <<uses>>

DermatologistProfileCommandServiceImpl ..> DermatologistProfileRepository : <<uses>>
DermatologistProfileCommandServiceImpl ..> DermatologistProfile : <<uses>>
DermatologistProfileCommandServiceImpl ..> RegisterDermatologistProfileCommand : <<uses>>
DermatologistProfileCommandServiceImpl ..> UpdateDermatologistProfileCommand : <<uses>>

AvailabilityQueryServiceImpl ..> AvailabilityRepository : <<uses>>
AvailabilityQueryServiceImpl ..> GetAvailabilityByDermatologistIdQuery : <<uses>>
AvailabilityQueryServiceImpl ..> GetAvailabilityByDermatologistIdAndDayQuery : <<uses>>

DermatologistProfileQueryServiceImpl ..> DermatologistProfileRepository : <<uses>>
DermatologistProfileQueryServiceImpl ..> GetDermatologistProfileByIdQuery : <<uses>>
DermatologistProfileQueryServiceImpl ..> GetDermatologistProfileByDermatologistIdQuery : <<uses>>
DermatologistProfileQueryServiceImpl ..> GetAllDermatologistProfilesQuery : <<uses>>

AvailabilityDefinedEventHandler ..> AvailabilityDefinedEvent : <<listens to>>
AvailabilityDefinedEventHandler ..> AvailabilityDefinedIntegrationEvent : <<publishes>>

DermatologistRegisteredEventHandler --> DermatologistProfileCommandService : dermatologistProfileCommandService
DermatologistRegisteredEventHandler ..> DermatologistRegisteredIntegrationEvent : <<listens to>>
DermatologistRegisteredEventHandler ..> RegisterDermatologistProfileCommand : <<creates>>
DermatologistRegisteredEventHandler ..> DermatologistId : <<uses>>

ExternalIamService --> IamContextFacade : iamContextFacade
ExternalIamService ..> DermatologistId : <<creates>>

DermatologyCareContextFacadeImpl --> DermatologistProfileQueryService : profileQueryService
DermatologyCareContextFacadeImpl ..> GetDermatologistProfileByDermatologistIdQuery : <<uses>>
DermatologyCareContextFacadeImpl ..> DermatologistId : <<uses>>

note bottom of ExternalIamService
  Wraps IAM's ACL facade (a different
  bounded context) in Dermatology Care's
  own outbound-port vocabulary.
end note
@enduml
