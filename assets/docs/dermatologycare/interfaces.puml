@startuml
title dermatologycare - interfaces
hide empty members
skinparam classAttributeIconSize 0

package "acl" {
    interface DermatologyCareContextFacade {
        +existsDermatologistProfileByDermatologistId(dermatologistId : Long) : boolean
        +fetchProfileIdByDermatologistId(dermatologistId : Long) : Long
        +fetchConsultationFeeByDermatologistId(dermatologistId : Long) : Double
    }
}

package "events" {
    class AvailabilityDefinedIntegrationEvent << record >> {
        +availabilityId : Long
        +dermatologistId : Long
        +dayOfWeek : String
        +startTime : String
        +endTime : String
        +from(availability : Availability) : AvailabilityDefinedIntegrationEvent
    }
}

package "rest" {
    class AvailabilityController {
        -queryService : AvailabilityQueryService
        -commandService : AvailabilityCommandService
        +AvailabilityController(queryService : AvailabilityQueryService, commandService : AvailabilityCommandService)
    }
    class DermatologistProfileController {
        -queryService : DermatologistProfileQueryService
        -commandService : DermatologistProfileCommandService
        +DermatologistProfileController(queryService : DermatologistProfileQueryService, commandService : DermatologistProfileCommandService)
    }
}

package "rest.resources" {
    class DermatologistProfileResource << record >> {
        +id : Long
        +dermatologistId : Long
        +firstName : String
        +lastName : String
        +specialtyName : String
        +licenseNumber : String
        +contactPhone : String
        +biography : String
        +consultationFee : Double
    }
}

package "rest.transform" {
    class AvailabilityResourceFromEntityAssembler {
        -AvailabilityResourceFromEntityAssembler()
        +toResourceFromEntity(availability : Availability) : AvailabilityResource
    }
    class DefineAvailabilityCommandFromResourceAssembler {
        -DefineAvailabilityCommandFromResourceAssembler()
        +toCommandFromResource(resource : DefineAvailabilityResource) : DefineAvailabilityCommand
    }
    class DermatologistProfileResourceFromEntityAssembler {
        -DermatologistProfileResourceFromEntityAssembler()
        +toResourceFromEntity(profile : DermatologistProfile) : DermatologistProfileResource
    }
    class UpdateAvailabilityCommandFromResourceAssembler {
        -UpdateAvailabilityCommandFromResourceAssembler()
        +toCommandFromResource(availabilityId : Long, resource : UpdateAvailabilityResource) : UpdateAvailabilityCommand
    }
    class UpdateDermatologistProfileCommandFromResourceAssembler {
        -UpdateDermatologistProfileCommandFromResourceAssembler()
        +toCommandFromResource(profileId : Long, resource : UpdateDermatologistProfileResource) : UpdateDermatologistProfileCommand
    }
}

DermatologistProfileResourceFromEntityAssembler ..> DermatologistProfileResource
@enduml