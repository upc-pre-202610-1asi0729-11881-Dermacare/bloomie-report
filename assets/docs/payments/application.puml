@startuml
title payments - application
hide empty members
skinparam classAttributeIconSize 0

package "commandservices" {
    interface PaymentCommandService {
        +handle(command : ProcessSubscriptionPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : ProcessRenewalPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : RefundPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : ProcessConsultationPaymentCommand) : Result<Payment,ApplicationError>
    }
}

package "internal.commandservices" {
    class PaymentCommandServiceImpl {
        -PAYMENT_NOT_FOUND : String
        -PAYMENT_CANNOT_REFUND : String
        -paymentRepository : PaymentRepository
        -externalSubscriptionService : ExternalSubscriptionService
        +PaymentCommandServiceImpl(paymentRepository : PaymentRepository, externalSubscriptionService : ExternalSubscriptionService)
        +handle(command : ProcessSubscriptionPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : ProcessRenewalPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : RefundPaymentCommand) : Result<Payment,ApplicationError>
        +handle(command : ProcessConsultationPaymentCommand) : Result<Payment,ApplicationError>
    }
}

package "internal.eventhandlers" {
    class ConsultationPaymentRequestedEventHandler {
        -paymentCommandService : PaymentCommandService
        +ConsultationPaymentRequestedEventHandler(paymentCommandService : PaymentCommandService)
        +on(event : RequestConsultationPaymentIntegrationEvent) : void
    }
    class PaymentProcessedDomainEventHandler {
        -eventPublisher : ApplicationEventPublisher
        +PaymentProcessedDomainEventHandler(eventPublisher : ApplicationEventPublisher)
        +on(event : SubscriptionPaymentProcessedEvent) : void
    }
    class RenewalPaymentProcessedDomainEventHandler {
        -eventPublisher : ApplicationEventPublisher
        +RenewalPaymentProcessedDomainEventHandler(eventPublisher : ApplicationEventPublisher)
        +on(event : SubscriptionRenewalPaymentProcessedEvent) : void
    }
    class SubscriptionPaymentProcessedEventHandler {
        -paymentCommandService : PaymentCommandService
        -externalSubscriptionService : ExternalSubscriptionService
        +SubscriptionPaymentProcessedEventHandler(paymentCommandService : PaymentCommandService, externalSubscriptionService : ExternalSubscriptionService)
        +on(event : SubscriptionPlanSelectedIntegrationEvent) : void
    }
}

package "internal.outboundservices.acl" {
    class ExternalSubscriptionService {
        -subscriptionContextFacade : SubscriptionContextFacade
        +ExternalSubscriptionService(subscriptionContextFacade : SubscriptionContextFacade)
        +fetchPlanById(planId : Long) : Optional<Long>
        +fetchPlanPrice(planId : Long) : Optional<Double>
    }
}

package "internal.outboundservices.stripe" {
    interface StripeCheckoutService {
        +createCheckoutSession(patientId : Long, planId : Long, planName : String, amount : Double) : String
    }
}

package "internal.queryservices" {
    class PaymentQueryServiceImpl {
        -paymentRepository : PaymentRepository
        +PaymentQueryServiceImpl(paymentRepository : PaymentRepository)
        +handle(query : GetPaymentByIdQuery) : Optional<Payment>
        +handle(query : GetPaymentsByPatientIdQuery) : List<Payment>
        +handle(query : GetPaymentBySubscriptionIdQuery) : Optional<Payment>
        +handle(query : GetPaymentByAppointmentIdQuery) : Optional<Payment>
    }
}

package "queryservices" {
    interface PaymentQueryService {
        +handle(query : GetPaymentByIdQuery) : Optional<Payment>
        +handle(query : GetPaymentsByPatientIdQuery) : List<Payment>
        +handle(query : GetPaymentBySubscriptionIdQuery) : Optional<Payment>
        +handle(query : GetPaymentByAppointmentIdQuery) : Optional<Payment>
    }
}

PaymentCommandServiceImpl ..|> PaymentCommandService
PaymentCommandServiceImpl --> ExternalSubscriptionService : externalSubscriptionService
ConsultationPaymentRequestedEventHandler --> PaymentCommandService : paymentCommandService
SubscriptionPaymentProcessedEventHandler --> PaymentCommandService : paymentCommandService
SubscriptionPaymentProcessedEventHandler --> ExternalSubscriptionService : externalSubscriptionService
PaymentQueryServiceImpl ..|> PaymentQueryService
@enduml