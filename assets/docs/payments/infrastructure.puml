@startuml
title payments - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "persistence.jpa.adapters" {
    class PaymentRepositoryImpl {
        -paymentPersistenceRepository : PaymentPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +PaymentRepositoryImpl(paymentPersistenceRepository : PaymentPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<Payment>
        +save(payment : Payment) : Payment
        +findAllByPatientId(id : PatientId) : List<Payment>
        +findBySubscriptionId(id : SubscriptionId) : Optional<Payment>
        +findByAppointmentId(id : AppointmentId) : Optional<Payment>
    }
}

package "persistence.jpa.assemblers" {
    class PaymentPersistenceAssembler {
        +PaymentPersistenceAssembler()
        +toDomainFromPersistence(entity : PaymentPersistenceEntity) : Payment
        +toPersistenceFromDomain(payment : Payment) : PaymentPersistenceEntity
    }
}

package "persistence.jpa.converters" {
    class AppointmentIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : AppointmentId) : Long
        +convertToEntityAttribute(dbData : Long) : AppointmentId
    }
    class DermatologistIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : DermatologistId) : Long
        +convertToEntityAttribute(dbData : Long) : DermatologistId
    }
    class PatientIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PatientId) : Long
        +convertToEntityAttribute(dbData : Long) : PatientId
    }
    class PaymentAmountPersistenceConverter {
        +convertToDatabaseColumn(attribute : PaymentAmount) : Double
        +convertToEntityAttribute(dbData : Double) : PaymentAmount
    }
    class PlanIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PlanId) : Long
        +convertToEntityAttribute(dbData : Long) : PlanId
    }
    class SubscriptionIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : SubscriptionId) : Long
        +convertToEntityAttribute(dbData : Long) : SubscriptionId
    }
}

package "persistence.jpa.entities" {
    class PaymentPersistenceEntity {
        -patientId : PatientId
        -planId : PlanId
        -subscriptionId : SubscriptionId
        -appointmentId : AppointmentId
        -dermatologistId : DermatologistId
        -paymentAmount : PaymentAmount
        -platformFeeAmount : PaymentAmount
        -status : PaymentStatus
        -type : PaymentType
    }
}

package "persistence.jpa.repositories" {
    interface PaymentPersistenceRepository {
        +findAllByPatientId(patientId : PatientId) : List<PaymentPersistenceEntity>
        +findBySubscriptionId(subscriptionId : SubscriptionId) : Optional<PaymentPersistenceEntity>
        +findByAppointmentId(appointmentId : AppointmentId) : Optional<PaymentPersistenceEntity>
    }
}

package "stripe.services" {
    class StripeCheckoutServiceImpl {
        -stripeApiKey : String
        -successUrl : String
        -cancelUrl : String
        +init() : void
        +createCheckoutSession(patientId : Long, planId : Long, planName : String, amount : Double) : String
    }
}

PaymentRepositoryImpl --> PaymentPersistenceRepository : paymentPersistenceRepository
PaymentPersistenceAssembler ..> PaymentPersistenceEntity
PaymentPersistenceRepository ..> PaymentPersistenceEntity
@enduml