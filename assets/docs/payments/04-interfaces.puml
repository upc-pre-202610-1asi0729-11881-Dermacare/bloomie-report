}

package "payments.interfaces" as ifaces {

  package events {
    class SubscriptionPaymentProcessedIntegrationEvent <<integration event>>
    class SubscriptionRenewalPaymentProcessedIntegrationEvent <<integration event>>
  }

  package rest {
    class PaymentsController {
      - paymentCommandService: PaymentCommandService
      - paymentQueryService: PaymentQueryService
    }
    class CheckoutController {
      - stripeCheckoutService: StripeCheckoutService
    }
    class StripeWebhookController {
      - subscriptionCommandService: SubscriptionCommandService
      - webhookSecret: String
    }
  }

  package "rest.resources" as resources {
    class PaymentResource <<resource>>
    class ProcessSubscriptionPaymentResource <<resource>>
    class ProcessRenewalPaymentResource <<resource>>
    class CheckoutSessionResource <<resource>>
    class CreateCheckoutSessionResource <<resource>>
  }

  package "rest.transform" as transform {
    class PaymentResourceFromEntityAssembler <<static assembler>>
    class ProcessSubscriptionPaymentCommandFromResourceAssembler <<static assembler>>
    class ProcessRenewalPaymentCommandFromResourceAssembler <<static assembler>>
  }
}

