@startuml
title payments - interfaces
hide empty members
skinparam classAttributeIconSize 0

package "events" {
    class SubscriptionPaymentProcessedIntegrationEvent << record >> {
        +paymentId : Long
        +patientId : Long
        +planId : Long
        +subscriptionId : Long
        +amount : Double
    }
    class SubscriptionRenewalPaymentProcessedIntegrationEvent << record >> {
        +paymentId : Long
        +patientId : Long
        +planId : Long
        +subscriptionId : Long
        +amount : Double
    }
}

package "rest" {
    class CheckoutController {
        -stripeCheckoutService : StripeCheckoutService
        +CheckoutController(stripeCheckoutService : StripeCheckoutService)
    }
    class PaymentsController {
        -paymentCommandService : PaymentCommandService
        -paymentQueryService : PaymentQueryService
        +PaymentsController(paymentCommandService : PaymentCommandService, paymentQueryService : PaymentQueryService)
    }
    class StripeWebhookController {
        -log : Logger
        -webhookSecret : String
        -subscriptionCommandService : SubscriptionCommandService
        +StripeWebhookController(subscriptionCommandService : SubscriptionCommandService)
        +handleWebhook(payload : String, sigHeader : String) : ResponseEntity<String>
    }
}

package "rest.resources" {
    class CreateCheckoutSessionResource << record >> {
        +patientId : Long
        +planId : Long
        +planName : String
        +amount : Double
    }
    class PaymentResource << record >> {
        +id : Long
        +patientId : Long
        +planId : Long
        +subscriptionId : Long
        +appointmentId : Long
        +dermatologistId : Long
        +paymentType : String
        +paymentAmount : Double
        +platformFeeAmount : Double
        +paymentStatus : String
    }
    class ProcessRenewalPaymentResource << record >> {
        +patientId : Long
        +planId : Long
        +subscriptionId : Long
        +amount : Double
    }
    class ProcessSubscriptionPaymentResource << record >> {
        +patientId : Long
        +planId : Long
        +subscriptionId : Long
        +paymentAmount : Double
    }
}

package "rest.transform" {
    class PaymentResourceFromEntityAssembler {
        +toResourceFromEntity(entity : Payment) : PaymentResource
    }
    class ProcessRenewalPaymentCommandFromResourceAssembler {
        +toCommandFromResource(resource : ProcessRenewalPaymentResource) : ProcessRenewalPaymentCommand
    }
    class ProcessSubscriptionPaymentCommandFromResourceAssembler {
        +toCommandFromResource(resource : ProcessSubscriptionPaymentResource) : ProcessSubscriptionPaymentCommand
    }
}

PaymentResourceFromEntityAssembler ..> PaymentResource
ProcessRenewalPaymentCommandFromResourceAssembler ..> ProcessRenewalPaymentResource
ProcessSubscriptionPaymentCommandFromResourceAssembler ..> ProcessSubscriptionPaymentResource
@enduml