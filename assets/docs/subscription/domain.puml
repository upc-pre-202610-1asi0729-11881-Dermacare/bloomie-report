@startuml
title subscription - domain
hide empty members
skinparam classAttributeIconSize 0

package "model.aggregates" {
    class Subscription {
        -id : Long
        -patientId : PatientId
        -planId : PlanId
        -status : SubscriptionStatus
        -startDate : LocalDateTime
        -endDate : LocalDateTime
        -activating : boolean
        -renewing : boolean
        -changingPlan : boolean
        -resubscribing : boolean
        -previousPlanId : PlanId
        +Subscription(id : Long, patientId : PatientId, planId : PlanId, status : SubscriptionStatus, startDate : LocalDateTime, endDate : LocalDateTime)
        +Subscription(command : SelectSubscriptionPlanCommand)
        +onPlanSelected() : void
        +activate(durationDays : int) : void
        +onActivated() : void
        +cancel() : void
        +onCancelled() : void
        +renew(durationDays : int) : void
        +onRenewed() : void
        +changePlan(newPlanId : PlanId) : void
        +onPlanChanged(previousPlanId : Long) : void
        +resubscribe(newPlanId : PlanId) : void
        +expire() : void
        +onExpired() : void
        +getPatientId() : Long
        +getPatientIdValue() : PatientId
        +getPlanId() : Long
        +getPlanIdValue() : PlanId
        +getPreviousPlanId() : Long
        +getStatus() : SubscriptionStatus
        +getStartDate() : LocalDateTime
        +getEndDate() : LocalDateTime
        +isActive() : boolean
        +isExpired() : boolean
    }
}

package "model.commands" {
    class ActivateSubscriptionCommand << record >> {
        +patientId : Long
        +planId : Long
    }
    class CancelSubscriptionCommand << record >> {
        +subscriptionId : Long
    }
    class ChangeSubscriptionPlanCommand << record >> {
        +subscriptionId : Long
        +newPlanId : Long
    }
    class ExpireSubscriptionCommand << record >> {
        +subscriptionId : Long
    }
    class RenewSubscriptionCommand << record >> {
        +subscriptionId : Long
    }
    class SeedPlansCommand << record >> {
    }
    class SelectSubscriptionPlanCommand << record >> {
        +patientId : Long
        +planId : Long
    }
}

package "model.entities" {
    class Plan {
        -id : Long
        -type : PlanType
        -name : String
        -price : Double
        -durationDays : Integer
        -modules : List<String>
        +Plan()
        +Plan(id : Long, type : PlanType, name : String, price : Double, durationDays : Integer, modules : List<String>)
        +getId() : Long
        +setId(id : Long) : void
        +getType() : PlanType
        +getName() : String
        +getPrice() : Double
        +getDurationDays() : Integer
        +getModules() : List<String>
    }
}

package "model.events" {
    class SubscriptionActivatedEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +planId : Long
        +from(subscription : Subscription) : SubscriptionActivatedEvent
    }
    class SubscriptionCancelledEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +planId : Long
        +from(subscription : Subscription) : SubscriptionCancelledEvent
    }
    class SubscriptionExpiredEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +planId : Long
        +expiredAt : LocalDateTime
        +from(subscription : Subscription) : SubscriptionExpiredEvent
    }
    class SubscriptionPlanChangedEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +previousPlanId : Long
        +newPlanId : Long
        +from(subscription : Subscription, previousPlanId : Long) : SubscriptionPlanChangedEvent
    }
    class SubscriptionPlanSelectedEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +planId : Long
        +from(subscription : Subscription) : SubscriptionPlanSelectedEvent
    }
    class SubscriptionRenewedEvent << record >> {
        +subscriptionId : Long
        +patientId : Long
        +planId : Long
        +newEndDate : LocalDateTime
        +from(subscription : Subscription) : SubscriptionRenewedEvent
    }
}

package "model.queries" {
    class GetAllPlansQuery << record >> {
    }
    class GetPlanByIdQuery << record >> {
        +planId : Long
    }
    class GetSubscriptionByIdQuery << record >> {
        +subscriptionId : Long
    }
    class GetSubscriptionByPatientIdQuery << record >> {
        +patientId : PatientId
    }
}

package "model.valueobjects" {
    class PatientId << record >> {
        +patientId : Long
    }
    class PlanId << record >> {
        +planId : Long
    }
    enum PlanType {
        STARTER
        ADVANCED
        ELITE
    }
    enum SubscriptionStatus {
        PENDING
        ACTIVE
        CANCELLED
        EXPIRED
    }
}

package "repositories" {
    interface PlanRepository {
        +findAll() : List<Plan>
        +findById(id : Long) : Optional<Plan>
        +findByType(type : PlanType) : Optional<Plan>
        +save(plan : Plan) : Plan
        +count() : long
    }
    interface SubscriptionRepository {
        +findById(id : Long) : Optional<Subscription>
        +findByPatientId(patientId : PatientId) : Optional<Subscription>
        +save(subscription : Subscription) : Subscription
        +existsById(id : Long) : boolean
        +existsByPatientId(patientId : PatientId) : boolean
        +findPlanById(planId : PlanId) : Optional<Plan>
        +findAllPlans() : List<Plan>
    }
}

Subscription --> PatientId : patientId
Subscription --> PlanId : planId
Subscription --> SubscriptionStatus : status
Subscription ..> SelectSubscriptionPlanCommand
Plan --> PlanType : type
SubscriptionActivatedEvent ..> Subscription
SubscriptionCancelledEvent ..> Subscription
SubscriptionExpiredEvent ..> Subscription
SubscriptionPlanChangedEvent ..> Subscription
SubscriptionPlanSelectedEvent ..> Subscription
SubscriptionRenewedEvent ..> Subscription
GetSubscriptionByPatientIdQuery --> PatientId : patientId
PlanRepository ..> Plan
PlanRepository ..> PlanType
SubscriptionRepository ..> Subscription
SubscriptionRepository ..> PatientId
SubscriptionRepository ..> PlanId
SubscriptionRepository ..> Plan
@enduml