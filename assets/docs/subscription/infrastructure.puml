@startuml
title subscription - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "persistence.jpa.adapters" {
    class PlanRepositoryImpl {
        -planPersistenceRepository : PlanPersistenceRepository
        +PlanRepositoryImpl(planPersistenceRepository : PlanPersistenceRepository)
        +findAll() : List<Plan>
        +findById(id : Long) : Optional<Plan>
        +findByType(type : PlanType) : Optional<Plan>
        +save(plan : Plan) : Plan
        +count() : long
    }
    class SubscriptionRepositoryImpl {
        -subscriptionPersistenceRepository : SubscriptionPersistenceRepository
        -planPersistenceRepository : PlanPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +SubscriptionRepositoryImpl(subscriptionPersistenceRepository : SubscriptionPersistenceRepository, planPersistenceRepository : PlanPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<Subscription>
        +findByPatientId(patientId : PatientId) : Optional<Subscription>
        +save(subscription : Subscription) : Subscription
        +existsById(id : Long) : boolean
        +existsByPatientId(patientId : PatientId) : boolean
        +findPlanById(planId : PlanId) : Optional<Plan>
        +findAllPlans() : List<Plan>
    }
}

package "persistence.jpa.assemblers" {
    class PlanPersistenceAssembler {
        -PlanPersistenceAssembler()
        +toDomainFromPersistence(entity : PlanPersistenceEntity) : Plan
        +toPersistenceFromDomain(plan : Plan) : PlanPersistenceEntity
    }
    class SubscriptionPersistenceAssembler {
        -SubscriptionPersistenceAssembler()
        +toDomainFromPersistence(entity : SubscriptionPersistenceEntity) : Subscription
        +toPersistenceFromDomain(subscription : Subscription) : SubscriptionPersistenceEntity
    }
}

package "persistence.jpa.converters" {
    class PatientIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PatientId) : Long
        +convertToEntityAttribute(dbData : Long) : PatientId
    }
    class PlanIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PlanId) : Long
        +convertToEntityAttribute(dbData : Long) : PlanId
    }
}

package "persistence.jpa.entities" {
    class PlanPersistenceEntity {
        -type : PlanType
        -name : String
        -price : Double
        -durationDays : Integer
    }
    class SubscriptionPersistenceEntity {
        -patientId : PatientId
        -planId : PlanId
        -status : SubscriptionStatus
        -startDate : LocalDateTime
        -endDate : LocalDateTime
    }
}

package "persistence.jpa.repositories" {
    interface PlanPersistenceRepository {
        +findByType(type : PlanType) : Optional<PlanPersistenceEntity>
    }
    interface SubscriptionPersistenceRepository {
        +findByPatientId(patientId : PatientId) : Optional<SubscriptionPersistenceEntity>
    }
}

PlanRepositoryImpl --> PlanPersistenceRepository : planPersistenceRepository
SubscriptionRepositoryImpl --> SubscriptionPersistenceRepository : subscriptionPersistenceRepository
SubscriptionRepositoryImpl --> PlanPersistenceRepository : planPersistenceRepository
PlanPersistenceAssembler ..> PlanPersistenceEntity
SubscriptionPersistenceAssembler ..> SubscriptionPersistenceEntity
PlanPersistenceRepository ..> PlanPersistenceEntity
SubscriptionPersistenceRepository ..> SubscriptionPersistenceEntity
@enduml