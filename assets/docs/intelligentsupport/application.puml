@startuml
title intelligentsupport - application
hide empty members
skinparam classAttributeIconSize 0

package "commandservices" {
    interface ChatMessageCommandService {
        +handle(command : SendChatMessageCommand) : Result<ChatMessage,ApplicationError>
    }
    interface SupportQueryCommandService {
        +handle(command : CreateSupportQueryCommand) : Result<SupportQuery,ApplicationError>
        +handle(command : UpdateSupportQueryStatusCommand) : Result<SupportQuery,ApplicationError>
    }
}

package "internal.commandservices" {
    class ChatMessageCommandServiceImpl {
        -chatMessageRepository : ChatMessageRepository
        -supportQueryRepository : SupportQueryRepository
        -aiService : AiService
        +ChatMessageCommandServiceImpl(chatMessageRepository : ChatMessageRepository, supportQueryRepository : SupportQueryRepository, aiService : AiService)
        +handle(command : SendChatMessageCommand) : Result<ChatMessage,ApplicationError>
    }
    class SupportQueryCommandServiceImpl {
        -supportQueryRepository : SupportQueryRepository
        +SupportQueryCommandServiceImpl(supportQueryRepository : SupportQueryRepository)
        +handle(command : CreateSupportQueryCommand) : Result<SupportQuery,ApplicationError>
        +handle(command : UpdateSupportQueryStatusCommand) : Result<SupportQuery,ApplicationError>
    }
}

package "internal.outboundservices.ai" {
    interface AiService {
        +generateSkincareResponse(userMessage : String, skinContext : String) : String
    }
}

package "internal.queryservices" {
    class ChatMessageQueryServiceImpl {
        -chatMessageRepository : ChatMessageRepository
        +ChatMessageQueryServiceImpl(chatMessageRepository : ChatMessageRepository)
        +handle(query : GetChatMessagesBySupportQueryIdQuery) : List<ChatMessage>
    }
    class SupportQueryQueryServiceImpl {
        -supportQueryRepository : SupportQueryRepository
        +SupportQueryQueryServiceImpl(supportQueryRepository : SupportQueryRepository)
        +handle(query : GetSupportQueryByIdQuery) : Optional<SupportQuery>
        +handle(query : GetSupportQueryByPatientIdAndStatusQuery) : Optional<SupportQuery>
    }
}

package "queryservices" {
    interface ChatMessageQueryService {
        +handle(query : GetChatMessagesBySupportQueryIdQuery) : List<ChatMessage>
    }
    interface SupportQueryQueryService {
        +handle(query : GetSupportQueryByIdQuery) : Optional<SupportQuery>
        +handle(query : GetSupportQueryByPatientIdAndStatusQuery) : Optional<SupportQuery>
    }
}

ChatMessageCommandServiceImpl ..|> ChatMessageCommandService
ChatMessageCommandServiceImpl --> AiService : aiService
SupportQueryCommandServiceImpl ..|> SupportQueryCommandService
ChatMessageQueryServiceImpl ..|> ChatMessageQueryService
SupportQueryQueryServiceImpl ..|> SupportQueryQueryService
@enduml