@startuml
title intelligentsupport - infrastructure
hide empty members
skinparam classAttributeIconSize 0

package "ai.services" {
    class GeminiAiServiceImpl {
        -SYSTEM_PROMPT : String
        -FALLBACK_RESPONSE : String
        -apiKey : String
        -apiUrl : String
        -restTemplate : RestTemplate
        -objectMapper : ObjectMapper
        +GeminiAiServiceImpl()
        +generateSkincareResponse(userMessage : String, skinContext : String) : String
        -buildPrompt(userMessage : String, skinContext : String) : String
        -extractTextFromResponse(responseBody : String) : String
    }
}

package "persistence.jpa.adapters" {
    class ChatMessageRepositoryImpl {
        -persistenceRepository : ChatMessagePersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +ChatMessageRepositoryImpl(persistenceRepository : ChatMessagePersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findAllBySupportQueryId(supportQueryId : SupportQueryId) : List<ChatMessage>
        +save(chatMessage : ChatMessage) : ChatMessage
    }
    class SupportQueryRepositoryImpl {
        -persistenceRepository : SupportQueryPersistenceRepository
        -eventPublisher : ApplicationEventPublisher
        +SupportQueryRepositoryImpl(persistenceRepository : SupportQueryPersistenceRepository, eventPublisher : ApplicationEventPublisher)
        +findById(id : Long) : Optional<SupportQuery>
        +findByPatientIdAndStatus(patientId : PatientId, status : SupportQueryStatus) : Optional<SupportQuery>
        +findAllByPatientId(patientId : PatientId) : List<SupportQuery>
        +save(supportQuery : SupportQuery) : SupportQuery
    }
}

package "persistence.jpa.assemblers" {
    class ChatMessagePersistenceAssembler {
        -ChatMessagePersistenceAssembler()
        +toDomainFromPersistence(entity : ChatMessagePersistenceEntity) : ChatMessage
        +toPersistenceFromDomain(chatMessage : ChatMessage) : ChatMessagePersistenceEntity
    }
    class SupportQueryPersistenceAssembler {
        -SupportQueryPersistenceAssembler()
        +toDomainFromPersistence(entity : SupportQueryPersistenceEntity) : SupportQuery
        +toPersistenceFromDomain(supportQuery : SupportQuery) : SupportQueryPersistenceEntity
    }
}

package "persistence.jpa.converters" {
    class PatientIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : PatientId) : Long
        +convertToEntityAttribute(dbData : Long) : PatientId
    }
    class SkinProfileIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : SkinProfileId) : Long
        +convertToEntityAttribute(dbData : Long) : SkinProfileId
    }
    class SupportQueryIdPersistenceConverter {
        +convertToDatabaseColumn(attribute : SupportQueryId) : Long
        +convertToEntityAttribute(dbData : Long) : SupportQueryId
    }
}

package "persistence.jpa.entities" {
    class ChatMessagePersistenceEntity {
        -supportQueryId : SupportQueryId
        -text : String
        -messageType : MessageType
        -sentAt : LocalDateTime
        +ChatMessagePersistenceEntity()
    }
    class SupportQueryPersistenceEntity {
        -patientId : PatientId
        -skinProfileId : SkinProfileId
        -status : SupportQueryStatus
        -suggestedAction : SuggestedAction
    }
}

package "persistence.jpa.repositories" {
    interface ChatMessagePersistenceRepository {
        +findAllBySupportQueryId(supportQueryId : SupportQueryId) : List<ChatMessagePersistenceEntity>
    }
    interface SupportQueryPersistenceRepository {
        +findByPatientIdAndStatus(patientId : PatientId, status : SupportQueryStatus) : Optional<SupportQueryPersistenceEntity>
        +findAllByPatientId(patientId : PatientId) : List<SupportQueryPersistenceEntity>
    }
}

ChatMessageRepositoryImpl --> ChatMessagePersistenceRepository : persistenceRepository
SupportQueryRepositoryImpl --> SupportQueryPersistenceRepository : persistenceRepository
ChatMessagePersistenceAssembler ..> ChatMessagePersistenceEntity
SupportQueryPersistenceAssembler ..> SupportQueryPersistenceEntity
ChatMessagePersistenceRepository ..> ChatMessagePersistenceEntity
SupportQueryPersistenceRepository ..> SupportQueryPersistenceEntity
@enduml