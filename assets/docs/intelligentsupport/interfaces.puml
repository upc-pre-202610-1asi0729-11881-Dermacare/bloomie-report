@startuml
title intelligentsupport - interfaces
hide empty members
skinparam classAttributeIconSize 0

package "rest" {
    class ChatMessagesController {
        -commandService : ChatMessageCommandService
        -queryService : ChatMessageQueryService
        +ChatMessagesController(commandService : ChatMessageCommandService, queryService : ChatMessageQueryService)
    }
    class SupportQueriesController {
        -commandService : SupportQueryCommandService
        -supportQueryQueryService : SupportQueryQueryService
        +SupportQueriesController(commandService : SupportQueryCommandService, supportQueryQueryService : SupportQueryQueryService)
    }
}

package "rest.resources" {
    class ChatMessageResource << record >> {
        +id : Long
        +supportQueryId : Long
        +text : String
        +messageType : String
        +sentAt : String
    }
    class CreateSupportQueryResource << record >> {
        +patientId : Long
        +skinProfileId : Long
    }
    class SendChatMessageResource << record >> {
        +supportQueryId : Long
        +text : String
    }
    class SupportQueryResource << record >> {
        +id : Long
        +patientId : Long
        +skinProfileId : Long
        +status : String
        +suggestedAction : String
        +createdAt : String
    }
    class UpdateSupportQueryStatusResource << record >> {
        +status : String
    }
}

package "rest.transform" {
    class ChatMessageResourceFromEntityAssembler {
        -ChatMessageResourceFromEntityAssembler()
        +toResourceFromEntity(chatMessage : ChatMessage) : ChatMessageResource
    }
    class CreateSupportQueryCommandFromResourceAssembler {
        -CreateSupportQueryCommandFromResourceAssembler()
        +toCommandFromResource(resource : CreateSupportQueryResource) : CreateSupportQueryCommand
    }
    class SendChatMessageCommandFromResourceAssembler {
        -SendChatMessageCommandFromResourceAssembler()
        +toCommandFromResource(resource : SendChatMessageResource) : SendChatMessageCommand
    }
    class SupportQueryResourceFromEntityAssembler {
        -SupportQueryResourceFromEntityAssembler()
        +toResourceFromEntity(supportQuery : SupportQuery) : SupportQueryResource
    }
    class UpdateSupportQueryStatusCommandFromResourceAssembler {
        -UpdateSupportQueryStatusCommandFromResourceAssembler()
        +toCommandFromResource(supportQueryId : Long, resource : UpdateSupportQueryStatusResource) : UpdateSupportQueryStatusCommand
    }
}

ChatMessageResourceFromEntityAssembler ..> ChatMessageResource
CreateSupportQueryCommandFromResourceAssembler ..> CreateSupportQueryResource
SendChatMessageCommandFromResourceAssembler ..> SendChatMessageResource
SupportQueryResourceFromEntityAssembler ..> SupportQueryResource
UpdateSupportQueryStatusCommandFromResourceAssembler ..> UpdateSupportQueryStatusResource
@enduml